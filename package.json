{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run tests/unit src",
    "import:legacy": "tsx scripts/migrations/import_legacy.ts",
    "sync:from-supabase": "tsx scripts/maintenance/sync_from_supabase.ts",
    "audit": "tsx scripts/audit/run_orchestrator.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "minimist": "^1.2.8",
    "motion": "^12.23.24",
    "prisma": "^6.19.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "node-adodb": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/minimist": "^1.2.5",
    "autoprefixer": "^10.4.21",
    "lighthouse": "^13.4.1",
    "pdf-parse": "^2.4.5",
    "tsx": "^4.21.0",
    "vitest": "^4.1.10"
  }
}
