        }
        lines {
          text: "  { id: \"EM_MANUTENCAO\", name: \"Em Manuten\303\247\303\243o\", color: \"border-t-purple-500 bg-purple-50/10\", desc: \"Conserto ativo na bancada\" },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
