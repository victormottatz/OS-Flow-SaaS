  file_change {
    absolute_path_uri: "file:///src/components/Navbar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { LogOut, Wifi, WifiOff, Users, ClipboardList, TrendingUp, Settings, RefreshCw, Layers } from \"lucide-react\";\nimport { User, UserRole } from \"../types\";\n\ninterface NavbarProps {\n  user: User;\n  currentTab: string;\n  setCurrentTab: (tab: string) => void;\n  isOffline: boolean;\n  setIsOffline: (state: boolean) => void;\n  onLogout: () => void;\n  onQuickRoleSwitch: () => void;\n}\n\nexport default function Navbar({\n  user,\n  currentTab,\n  setCurrentTab,\n  isOffline,\n  setIsOffline,\n  onLogout,\n  onQuickRoleSwitch\n}: NavbarProps) {\n  return (\n    <header className=\"bg-slate-900 text-white shadow-md border-b border-slate-800\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16\">\n          {/* Brand Logo */}\n          <div className=\"flex items-center space-x-3 cursor-pointer\" onClick={() => setCurrentTab(\"dashboard\")}>\n            <div className=\"bg-teal-500 text-slate-900 p-2 rounded-lg font-bold shadow-md transform hover:rotate-6 transition-all\">\n              <span className=\"text-sm font-mono tracking-wider\">MGV</span>\n            </div>\n            <div>\n              <h1 className=\"text-lg font-bold tracking-tight text-white m-0 font-sans leading-none\">MGV Tecnologia</h1>\n              <p className=\"text-xs text-slate-400 font-mono m-0 mt-0.5 leading-none\">Assist\303\252ncia T\303\251cnica & Faturamento</p>\n            </div>\n          </div>\n\n          {/* Navigation Items */}\n          <nav className=\"hidden md:flex space-x-1 lg:space-x-2\">\n            {[\n              { id: \"dashboard\", label: \"Dashboard\", icon: TrendingUp },\n              { id: \"clients\", label: \"Clientes & Aparelhos\", icon: Users },\n              { id: \"os\", label: \"Nova Ordem de Servi\303\247o\", icon: ClipboardList },\n              { id: \"kanban\", label: \"Quadro T\303\251cnico\", icon: Layers },\n              { id: \"bling\", label: \"Painel Fiscal Bling\", icon: Settings },\n            ].map((tab) => {\n              const Icon = tab.icon;\n              const active = currentTab === tab.id;\n              return (\n                <button\n                  key={tab.id}\n                  id={`nav-tab-${tab.id}`}\n                  onClick={() => setCurrentTab(tab.id)}\n                  className={`flex items-center space-x-2 px-3.5 py-2 rounded-lg text-sm font-medium transition-all duration-200 ${\n                    active\n                      ? \"bg-slate-800 text-teal-400 border-b-2 border-teal-400 shadow-inner\"\n                      : \"text-slate-300 hover:text-white hover:bg-slate-800\"\n                  }`}\n                >\n                  <Icon className={`w-4 h-4 ${active ? \"text-teal-400\" : \"text-slate-400\"}`} />\n                  <span>{tab.label}</span>\n                </button>\n              );\n            })}\n          </nav>\n\n          {/* Controls & Quick Setup */}\n          <div className=\"flex items-center space-x-3\">\n            {/* Offline Simulation Toggle */}\n            <button\n              onClick={() => setIsOffline(!isOffline)}\n              className={`flex items-center space-x-1 px-2.5 py-1.5 rounded-md text-xs font-semibold uppercase tracking-wide transition-all border ${\n                isOffline\n                  ? \"bg-red-950 border-red-500 text-red-200 hover:bg-red-900 anim-pulse\"\n                  : \"bg-slate-800 border-teal-500/30 text-teal-400 hover:bg-slate-700 hover:border-teal-500\"\n              }`}\n              title={isOffline ? \"Clique para reconectar rede f\303\255sica\" : \"Clique para desvincular conex\303\243o (Modo Offline)\"}\n            >\n              {isOffline ? (\n                <>\n                  <WifiOff className=\"w-3.5 h-3.5\" />\n                  <span>Offline</span>\n                </>\n              ) : (\n                <>\n                  <Wifi className=\"w-3.5 h-3.5\" />\n                  <span>Online</span>\n                </>\n              )}\n            </button>\n\n            {/* Quick Switch Role */}\n            <button\n              onClick={onQuickRoleSwitch}\n              className=\"flex items-center space-x-1 px-2.5 py-1.5 text-xs text-slate-300 bg-slate-800 hover:bg-slate-700 hover:text-white rounded-md border border-slate-700\"\n              title=\"Alternar rapidamente entre OWNER e EDITOR para testar bloqueios\"\n            >\n              <RefreshCw className=\"w-3.5 h-3.5\" />\n              <span className=\"hidden sm:inline\">Alternar Perfil</span>\n            </button>\n\n            {/* Identity Badge */}\n            <div className=\"flex flex-col text-right hidden sm:block\">\n              <span className=\"text-xs font-semibold text-slate-100 block\">{user.name}</span>\n              <span\n                className={`text-[10px] uppercase font-mono tracking-wider px-1.5 py-0.5 rounded self-end ${\n                  user.role === UserRole.OWNER\n                    ? \"bg-teal-500/20 text-teal-300 border border-teal-500/30 font-bold\"\n                    : \"bg-amber-500/20 text-amber-300 border border-amber-500/30 font-bold\"\n                }`}\n              >\n                {user.role}\n              </span>\n            </div>\n\n            {/* Logout button */}\n            <button\n              id=\"logout-btn\"\n              onClick={onLogout}\n              className=\"bg-slate-800 p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-700 transition\"\n              title=\"Fazer logout da MGV\"\n            >\n              <LogOut className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Mobile navigation tab rail */}\n      <div className=\"md:hidden flex border-t border-slate-800 bg-slate-950 overflow-x-auto justify-around py-1.5 px-2\">\n        {[\n          { id: \"dashboard\", label: \"Painel\", icon: TrendingUp },\n          { id: \"clients\", label: \"Clientes\", icon: Users },\n          { id: \"os\", label: \"Abertura OS\", icon: ClipboardList },\n          { id: \"kanban\", label: \"Quadro\", icon: Layers },\n          { id: \"bling\", label: \"Fiscal\", icon: Settings },\n        ].map((tab) => {\n          const Icon = tab.icon;\n          const active = currentTab === tab.id;\n          return (\n            <button\n              key={tab.id}\n              onClick={() => setCurrentTab(tab.id)}\n              className={`flex flex-col items-center px-2 py-1 rounded text-[10px] font-medium transition-all ${\n                active ? \"text-teal-400 bg-slate-900\" : \"text-slate-400\"\n              }`}\n            >\n              <Icon className=\"w-4 h-4 mb-0.5\" />\n              <span>{tab.label}</span>\n            </button>\n          );\n        })}\n      </div>\n    </header>\n  );\n}\n"
    }
    diff {
