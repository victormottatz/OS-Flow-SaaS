  file_change {
    absolute_path_uri: "file:///src/components/BlingSandbox.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useState, useEffect } from \"react\";\nimport { OrdemServico, Client, Device } from \"../types\";\nimport { \n  Settings, RefreshCw, Layers, ShieldCheck, AlertCircle, FileText, Printer, \n  HelpCircle, Wifi, Play, HelpCircle as HelpIcon, X, Zap \n} from \"lucide-react\";\n\ninterface BlingSandboxProps {\n  ordensServico: OrdemServico[];\n  isOffline: boolean;\n  onRefresh: () => void;\n}\n\nexport default function BlingSandbox({ ordensServico, isOffline, onRefresh }: BlingSandboxProps) {\n  const [selectedOSId, setSelectedOSId] = useState(\"\");\n  const [forceErrorType, setForceErrorType] = useState<\"\" | \"SEFAZ_REJECT\" | \"UNAUTHORIZED\" | \"SERVICE_DOWN\" | \"MOCK_TIMEOUT\">(\"\");\n  const [isSyncing, setIsSyncing] = useState(false);\n  const [syncLogs, setSyncLogs] = useState<string[]>([]);\n  const [syncStatusMsg, setSyncStatusMsg] = useState(\"\");\n  const [errorHeader, setErrorHeader] = useState(\"\");\n  \n  // Backoff simulation visual timers\n  const [backoffTimer, setBackoffTimer] = useState<number | null>(null);\n  \n  // Selected OS record\n  const selectedOS = ordensServico.find(o => o.id === selectedOSId);\n\n  // DANFE view states\n  const [activeDanfeOS, setActiveDanfeOS] = useState<OrdemServico | null>(null);\n  const [danfeData, setDanfeData] = useState<any>(null);\n\n  // Set default selected OS on load to first finalizado\n  useEffect(() => {\n    if (!selectedOSId && ordensServico.length > 0) {\n      const finalizada = ordensServico.find(o => o.status === \"FINALIZADO\" || o.status === \"PRONTO_RETIRADA\");\n      if (finalizada) {\n        setSelectedOSId(finalizada.id);\n      } else {\n        setSelectedOSId(ordensServico[0].id);\n      }\n    }\n  }, [ordensServico]);\n\n  const triggerBlingInvoice = async (osId: string) => {\n    if (isOffline) {\n      alert(\"Erro fiscal: Opera\303\247\303\243o offline. Imparidade f\303\255sica detectada.\");\n      return;\n    }\n\n    setIsSyncing(true);\n    setSyncLogs([\"Iniciando trigger de sinc de vendas no canal...\"]);\n    setErrorHeader(\"\");\n    setSyncStatusMsg(\"Conectando de forma s\303\255ncrona aos servidores da Bling...\");\n    setBackoffTimer(null);\n\n    const useTimeout = forceErrorType === \"MOCK_TIMEOUT\";\n\n    try {\n      // Simulate front-end status progression as requested in Spec\n      setTimeout(() => {\n        setSyncStatusMsg(\"Enviando dados estruturados... Aguardando SEFAZ/Bling...\");\n        setSyncLogs(prev => [...prev, \"Bling API V3 Gateway: Payload validado localmente.\", \"Aguardando retorno s\303\255ncrono da SEFAZ...\"]);\n      }, 1000);\n\n      const response = await fetch(`/api/integration/bling/sync/${osId}`, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          forceErrorType: forceErrorType === \"MOCK_TIMEOUT\" ? \"\" : forceErrorType,\n          simulatedTimeout: useTimeout\n        })\n      });\n\n      const data = await response.json();\n\n      if (!response.ok) {\n        throw { status: response.status, data };\n      }\n\n      setSyncStatusMsg(\"Faturamento conclu\303\255do com sucesso!\");\n      setSyncLogs(data.os?.billingLogs || [\"Sucesso na integra\303\247\303\243o de notas!\"]);\n      onRefresh();\n\n    } catch (err: any) {\n      const respStatus = err.status;\n      const respData = err.data;\n\n      // SPEC: Exponential Backoff retry mechanism simulation\n      if (respStatus === 503) {\n        setSyncStatusMsg(\"Gateway indispon\303\255vel. Iniciando mecanismo de retentativas programadas...\");\n        \n        // Simular Backoff Exponencial visual de 3 tentativas\n        setSyncLogs(prev => [...prev, \"[FALHA 503] Ativando Backoff Exponencial de retentativas f\303\255sicas...\"]);\n        \n        let attempt = 1;\n        const retryTimes = [5, 10, 15]; // shorter visual times than 5s, 15s, 45s for demo responsiveness\n        \n        const runRetry = () => {\n          if (attempt > 3) {\n            setSyncStatusMsg(\"Sincronia falhou ap\303\263s 3 tentativas. Opera\303\247\303\243o movida para Fila de Lote.\");\n            setSyncLogs(prev => [...prev, \"[EXCEDIDO] Todas as retentativas falharam. Finalizado com Erro local.\"]);\n            setIsSyncing(false);\n            onRefresh();\n            return;\n          }\n\n          setSyncLogs(prev => [...prev, `[BACKOFF] Preparando retentativa ${attempt}/3... aguardando.`]);\n          \n          let secondsLeft = retryTimes[attempt - 1];\n          const timerInterval = setInterval(() => {\n            secondsLeft--;\n            setSyncStatusMsg(`Retentando em ${secondsLeft}s... (Tentativa ${attempt}/3)`);\n            if (secondsLeft <= 0) {\n              clearInterval(timerInterval);\n              setSyncLogs(prev => [...prev, `[RETENTATIVA ${attempt}] Despachando nota fiscal ao Bling...`]);\n              attempt++;\n              runRetry();\n            }\n          }, 1000);\n        };\n\n        runRetry();\n        return;\n\n      } else {\n        // Handle normal errors\n        setErrorHeader(respData?.error || \"Erro SEFAZ\");\n        setSyncStatusMsg(respData?.feedbackMessage || \"Emiss\303\243o fiscal rejeitada pelas valida\303\247\303\265es SEFAZ.\");\n        setSyncLogs(respData?.logs || [\"Erro na opera\303\247\303\243o\"]);\n        onRefresh();\n      }\n    } finally {\n      if (forceErrorType !== \"MOCK_TIMEOUT\" && forceErrorType !== \"SERVICE_DOWN\") {\n        setIsSyncing(false);\n      }\n    }\n  };\n\n  const handleOpenDanfe = async (os: OrdemServico) => {\n    if (!os.pdfUrl) return;\n\n    try {\n      const response = await fetch(os.pdfUrl);\n      const data = await response.json();\n      setActiveDanfeOS(os);\n      setDanfeData(data);\n    } catch (err) {\n      alert(\"Erro ao decodificar DANFE.\");\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"border-b border-slate-100 pb-5\">\n        <h2 className=\"text-2xl font-bold text-slate-950 tracking-tight\">Painel de Integra\303\247\303\243o Externa & Fiscal</h2>\n        <p className=\"text-slate-500 text-sm\">Interface de rastreabilidade do faturamento automatizado de OSs via ERP Bling V3</p>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Left column: Setup simulations and testing */}\n        <div className=\"bg-white rounded-xl border border-slate-200 p-6 space-y-5 shadow-sm\">\n          <h3 className=\"text-sm font-bold text-slate-900 uppercase tracking-wider flex items-center space-x-2 border-b border-slate-100 pb-2\">\n            <Settings className=\"w-4 h-4 text-teal-500\" />\n            <span>Simulador de Homologa\303\247\303\243o</span>\n          </h3>\n\n          <p className=\"text-xs text-slate-500 leading-relaxed\">\n            Como faturamento com a SEFAZ real possui regras restritas, use as configura\303\247\303\265es abaixo para testar o comportamento do sistema diante de falhas de comunica\303\247\303\243o e rejei\303\247\303\265es de impostos:\n          </p>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Selecione uma Ordem de Servi\303\247o:</label>\n            <select\n              value={selectedOSId}\n              onChange={(e) => setSelectedOSId(e.target.value)}\n              className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-xs bg-white text-slate-800\"\n            >\n              <option value=\"\">-- Escolher OS --</option>\n              {ordensServico.map(os => (\n                <option key={os.id} value={os.id}>\n                  {os.osNumber} - {(os as any).client?.name} (Status: {os.status})\n                </option>\n              ))}\n            </select>\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-700 mb-2\">For\303\247ar tipo de Erro Fiscal SEFAZ/Bling:</label>\n            <div className=\"space-y-2\">\n              {[\n                { id: \"\", label: \"Sucesso Absoluto (Faturamento autoriza na hora)\", color: \"text-emerald-700\" },\n                { id: \"MOCK_TIMEOUT\", label: \"Timeout de Comunica\303\247\303\243o (Excede limite s\303\255ncrono de 10s)\", color: \"text-amber-700\" },\n                { id: \"SEFAZ_REJECT\", label: \"Rejeitado pela SEFAZ (Valida\303\247\303\265es de inscri\303\247\303\243o/imposto)\", color: \"text-red-700\" },\n                { id: \"UNAUTHORIZED\", label: \"N\303\243o Autorizado (Assinatura digital/Chave de API expirada)\", color: \"text-red-700\" },\n                { id: \"SERVICE_DOWN\", label: \"Servidores em Manuten\303\247\303\243o (C\303\263digo HTTP 503)\", color: \"text-purple-700\" },\n              ].map(opt => (\n                <label key={opt.id} className=\"flex items-start space-x-2 p-2 rounded-lg border border-slate-100 hover:bg-slate-50 cursor-pointer text-xs\">\n                  <input\n                    type=\"radio\"\n                    name=\"error-forced\"\n                    checked={forceErrorType === opt.id}\n                    onChange={() => setForceErrorType(opt.id as any)}\n                    className=\"mt-0.5 text-teal-600 focus:ring-teal-500\"\n                  />\n                  <span className={`font-semibold ${opt.color}`}>{opt.label}</span>\n                </label>\n              ))}\n            </div>\n          </div>\n\n          <button\n            onClick={() => selectedOSId && triggerBlingInvoice(selectedOSId)}\n            disabled={!selectedOSId || isSyncing}\n            className=\"w-full bg-slate-900 text-white font-bold text-xs py-2.5 rounded-lg hover:bg-slate-800 transition flex items-center justify-center space-x-2 disabled:bg-slate-300\"\n          >\n            <Zap className=\"w-3.5 h-3.5 text-teal-400\" />\n            <span>{isSyncing ? \"Processando...\" : \"Sincronizar OS no Bling\"}</span>\n          </button>\n        </div>\n\n        {/* Middle column: Sinc Live logs & Circuit Breaker */}\n        <div className=\"bg-slate-900 text-slate-100 rounded-xl p-6 flex flex-col justify-between shadow-md lg:col-span-2\">\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center justify-between border-b border-slate-800 pb-2\">\n              <span className=\"text-xs uppercase font-mono tracking-wider text-teal-400 flex items-center space-x-1.5\">\n                <span className=\"relative flex h-2 w-2\">\n                  <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-450 opacity-75\"></span>\n                  <span className=\"relative inline-flex rounded-full h-2 w-2 bg-teal-500\"></span>\n                </span>\n                <span>Console Monitor Fiscal</span>\n              </span>\n              <span className=\"text-[10px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded font-mono\">\n                Port: HTTPS/V3\n              </span>\n            </div>\n\n            {/* Simulated interactive steps screen */}\n            {isSyncing || syncLogs.length > 0 ? (\n              <div className=\"space-y-3 font-mono text-xs max-h-[300px] overflow-y-auto bg-slate-950 p-4 rounded-lg border border-slate-850\">\n                <p className=\"text-slate-400\">--- IN\303\215CIO DE EXECU\303\207\303\203O ---</p>\n                {syncLogs.map((log, idx) => (\n                  <p key={idx} className={`${\n                    log.includes(\"[SEFAZ REJECT]\") || log.includes(\"[HTTP\") ? \"text-red-400\" :\n                    log.includes(\"[BACKOFF]\") ? \"text-amber-400\" :\n                    log.includes(\"sucesso\") || log.includes(\"autorizou\") ? \"text-emerald-400 font-bold\" :\n                    \"text-slate-300\"\n                  }`}>\n                    {log}\n                  </p>\n                ))}\n                \n                {isSyncing && (\n                  <div className=\"py-2 flex items-center space-x-2 font-semibold text-teal-400 anim-pulse\">\n                    <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n                    <span>{syncStatusMsg}</span>\n                  </div>\n                )}\n              </div>\n            ) : (\n              <div className=\"text-center py-16 text-slate-500 font-mono text-xs\">\n                Selecione uma OS e aperte faturar para iniciar a varredura SEFAZ em tempo real.\n              </div>\n            )}\n\n            {/* Error notifications */}\n            {errorHeader && (\n              <div className=\"bg-red-950 border border-red-800 rounded-lg p-3 text-red-200 text-xs flex items-start space-x-2.5\">\n                <AlertCircle className=\"w-4 h-4 text-red-400 shrink-0 mt-0.5\" />\n                <div>\n                  <strong className=\"font-bold block uppercase\">{errorHeader}</strong>\n                  <p className=\"mt-0.5 text-red-300\">{syncStatusMsg}</p>\n                </div>\n              </div>\n            )}\n          </div>\n\n          <div className=\"pt-4 border-t border-slate-800 text-xs text-slate-400 flex flex-wrap gap-4 mt-6\">\n            <p className=\"flex items-center space-x-1\">\n              <ShieldCheck className=\"w-3.5 h-3.5 text-teal-400\" />\n              <span>Criptografia SSL TLSv1.3 habilitada</span>\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* Completed finalizadas table list of sales invoices */}\n      <div className=\"bg-white rounded-xl border border-slate-200 shadow-sm p-6 overflow-hidden\">\n        <h3 className=\"text-sm font-bold text-slate-950 uppercase tracking-wider mb-4\">Notas Fiscais de Servi\303\247os & Pe\303\247as (NFe)</h3>\n        \n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs text-slate-600\">\n            <thead className=\"text-[10px] uppercase text-slate-500 bg-slate-50 border-b border-slate-100\">\n              <tr>\n                <th className=\"p-3\">Numera\303\247\303\243o</th>\n                <th className=\"p-3\">Cliente</th>\n                <th className=\"p-3 font-mono\">Chave de Acesso SEFAZ</th>\n                <th className=\"p-3\">Valor Total</th>\n                <th className=\"p-3\">Integra\303\247\303\243o</th>\n                <th className=\"p-3 text-right\">A\303\247\303\243o</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {ordensServico.filter(os => os.status === \"FINALIZADO\").length === 0 ? (\n                <tr>\n                  <td colSpan={6} className=\"text-center py-6 text-slate-400 italic\">\n                    N\303\243o existem ordens arquivadas como \"Finalizado\" para faturamento.\n                  </td>\n                </tr>\n              ) : (\n                ordensServico.filter(os => os.status === \"FINALIZADO\").map(os => (\n                  <tr key={os.id} className=\"hover:bg-slate-50/50 transition\">\n                    <td className=\"p-3 font-bold text-slate-900\">{os.osNumber}</td>\n                    <td className=\"p-3 font-bold\">{(os as any).client?.name || \"N/A\"}</td>\n                    <td className=\"p-3 font-mono\">{os.blingKey ? os.blingKey.slice(0, 24) + \"...\" : \"---\"}</td>\n                    <td className=\"p-3 font-bold font-mono text-slate-900\">R$ {os.totalCost.toFixed(2)}</td>\n                    <td className=\"p-3\">\n                      <span className={`inline-flex px-2 py-0.5 rounded-full text-[10px] font-bold uppercase ${\n                        os.billingStatus === \"FATURADO\" ? \"bg-emerald-100 text-emerald-800\" :\n                        os.billingStatus === \"REJEITADO\" ? \"bg-red-100 text-red-800\" :\n                        os.billingStatus === \"TIMEOUT\" ? \"bg-amber-100 text-amber-800\" :\n                        \"bg-slate-100 text-slate-600\"\n                      }`}>\n                        {os.billingStatus}\n                      </span>\n                    </td>\n                    <td className=\"p-3 text-right\">\n                      {os.billingStatus === \"FATURADO\" ? (\n                        <button\n                          onClick={() => handleOpenDanfe(os)}\n                          className=\"bg-slate-900 hover:bg-slate-800 text-white font-bold text-[10px] px-2.5 py-1.5 rounded uppercase font-mono tracking-wide flex items-center space-x-1.5 inline-flex ml-auto\"\n                        >\n                          <FileText className=\"w-3.5 h-3.5 text-teal-400\" />\n                          <span>Abrir DANFE (Tela)</span>\n                        </button>\n                      ) : (\n                        <button\n                          onClick={() => triggerBlingInvoice(os.id)}\n                          className=\"bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-[10px] px-2.5 py-1.5 rounded uppercase font-mono tracking-wide inline-flex ml-auto-item ml-auto\"\n                        >\n                          Tentar Re-envio\n                        </button>\n                      )}\n                    </td>\n                  </tr>\n                ))\n              )}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      {/* API Reference table from Specification */}\n      <div className=\"bg-slate-50 rounded-lg p-5 border border-slate-200 mt-6 text-xs text-slate-600\">\n        <h4 className=\"font-bold text-slate-800 uppercase text-[10px] tracking-wider mb-2 flex items-center space-x-1\">\n          <HelpIcon className=\"w-3.5 h-3.5 text-teal-600\" />\n          <span>Tabela de Refer\303\252ncia Fiscal (C\303\263digos de Opera\303\247\303\243o Bling API V3)</span>\n        </h4>\n        <div className=\"grid grid-cols-1 md:grid-cols-5 gap-3 mt-3\">\n          <div className=\"bg-white p-2.5 rounded border border-slate-200/50\">\n            <span className=\"font-mono font-bold text-emerald-700 block text-xs\">200 OK</span>\n            <span className=\"text-[10px] text-slate-500\">Sucesso na gera\303\247\303\243o fiscal SEFAZ.</span>\n          </div>\n          <div className=\"bg-white p-2.5 rounded border border-slate-200/50\">\n            <span className=\"font-mono font-bold text-amber-700 block text-xs\">400 Bad Request</span>\n            <span className=\"text-[10px] text-slate-500\">Invalidez de digita\303\247\303\243o documental.</span>\n          </div>\n          <div className=\"bg-white p-2.5 rounded border border-slate-200/50\">\n            <span className=\"font-mono font-bold text-red-700 block text-xs\">401 Unauthorized</span>\n            <span className=\"text-[10px] text-slate-500\">Chave API Bling desatualizada.</span>\n          </div>\n          <div className=\"bg-white p-2.5 rounded border border-slate-200/50\">\n            <span className=\"font-mono font-bold text-red-700 block text-xs\">422 Unproc Entity</span>\n            <span className=\"text-[10px] text-slate-500\">Nota rejeitada pela SEFAZ de destino.</span>\n          </div>\n          <div className=\"bg-white p-2.5 rounded border border-slate-200/50\">\n            <span className=\"font-mono font-bold text-purple-700 block text-xs\">503 Service Down</span>\n            <span className=\"text-[10px] text-slate-500\">Servidores do posto fiscal offline.</span>\n          </div>\n        </div>\n      </div>\n\n      {/* DANFE MODAL PREVIEW ON SCREEN */}\n      {activeDanfeOS && danfeData && (\n        <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 z-50 overflow-y-auto\">\n          <div className=\"bg-white rounded-xl shadow-2xl border border-slate-200 w-full max-w-4xl max-h-[95vh] overflow-y-auto flex flex-col\">\n            \n            {/* Modal header with options */}\n            <div className=\"p-4 bg-slate-900 text-white flex items-center justify-between sticky top-0 z-10\">\n              <div className=\"flex items-center space-x-2\">\n                <FileText className=\"w-5 h-5 text-teal-400\" />\n                <h3 className=\"font-bold\">DANFE - Documento Auxiliar da Nota Fiscal Eletr\303\264nica</h3>\n              </div>\n              <div className=\"flex items-center space-x-2\">\n                <button\n                  onClick={() => window.print()}\n                  className=\"bg-teal-500 hover:bg-teal-600 text-slate-950 font-bold px-3 py-1.5 rounded-lg text-xs flex items-center space-x-1.5 transition\"\n                >\n                  <Printer className=\"w-3.5 h-3.5\" />\n                  <span>Imprimir NFe</span>\n                </button>\n                <button onClick={() => { setActiveDanfeOS(null); setDanfeData(null); }} className=\"text-slate-400 hover:text-white transition\">\n                  <X className=\"w-5 h-5\" />\n                </button>\n              </div>\n            </div>\n\n            {/* DANFE Layout */}\n            <div id=\"printable-danfe\" className=\"p-8 font-sans text-[10px] text-black bg-white select-none\">\n              \n              {/* Outer Border Box */}\n              <div className=\"border border-black p-4 space-y-4\">\n                \n                {/* 1. EMITENTE E CHAVE */}\n                <div className=\"grid grid-cols-1 md:grid-cols-3 gap-2 border-b border-black pb-3\">\n                  <div className=\"col-span-2 space-y-1 pr-4\">\n                    <h4 className=\"text-sm font-bold\">{danfeData.emitente.nome}</h4>\n                    <p className=\"text-slate-600\">Servi\303\247os t\303\251cnicos especializados em hardware Corporativo</p>\n                    <p className=\"font-mono\">{danfeData.emitente.logradouro} - {danfeData.emitente.cidade}</p>\n                    <p className=\"font-mono\">CEP: {danfeData.emitente.cep} - {danfeData.emitente.contato}</p>\n                  </div>\n                  <div className=\"border-l border-black pl-3 space-y-1\">\n                    <h5 className=\"font-bold block uppercase text-slate-500\">DANFE</h5>\n                    <p className=\"font-bold\">NF-e N\302\272 {danfeData.os.osNumber.replace(/\\D/g, \"\")}</p>\n                    <p>S\303\251rie: 001</p>\n                    <p className=\"font-mono tracking-tighter text-[8px] break-all bg-slate-50 p-1 font-bold\">\n                      CHAVE SEFAZ:<br/>{danfeData.os.blingKey}\n                    </p>\n                  </div>\n                </div>\n\n                {/* 2. NATUREZA E CADASTROS */}\n                <div className=\"grid grid-cols-3 gap-2 border-b border-black pb-3\">\n                  <div>\n                    <span className=\"font-bold block uppercase text-[8px] text-slate-500\">Natureza de Opera\303\247\303\243o</span>\n                    <strong className=\"text-slate-800\">Presta\303\247\303\243o de Servi\303\247os com Reposi\303\247\303\243o</strong>\n                  </div>\n                  <div>\n                    <span className=\"font-bold block uppercase text-[8px] text-slate-500\">Insc. Estadual Emitente</span>\n                    <strong className=\"font-mono\">{danfeData.emitente.ie}</strong>\n                  </div>\n                  <div>\n                    <span className=\"font-bold block uppercase text-[8px] text-slate-500\">CNPJ Emitente</span>\n                    <strong className=\"font-mono\">{danfeData.emitente.cnpj}</strong>\n                  </div>\n                </div>\n\n                {/* 3. DESTINAT\303\201RIO */}\n                <div className=\"border-b border-black pb-3 space-y-2\">\n                  <h5 className=\"font-bold uppercase text-[9px] text-slate-500 border-b border-slate-200 pb-0.5\">Destinat\303\241rio / Remetente</h5>\n                  <div className=\"grid grid-cols-3 gap-2\">\n                    <div className=\"col-span-2\">\n                      <span className=\"font-bold block text-[8px] text-slate-500\">Nome / Raz\303\243o Social</span>\n                      <strong>{danfeData.client.name}</strong>\n                    </div>\n                    <div>\n                      <span className=\"font-bold block text-[8px] text-slate-500\">CNPJ / CPF</span>\n                      <strong className=\"font-mono\">{danfeData.client.cpfCnpj}</strong>\n                    </div>\n                    <div className=\"col-span-2\">\n                      <span className=\"font-bold block text-[8px] text-slate-500\">Endere\303\247o de Entrega</span>\n                      <span>{danfeData.client.address}</span>\n                    </div>\n                    <div>\n                      <span className=\"font-bold block text-[8px] text-slate-500\">Telefone / E-mail</span>\n                      <span>{danfeData.client.phone} / {danfeData.client.email}</span>\n                    </div>\n                  </div>\n                </div>\n\n                {/* 4. ITENS E VALORES */}\n                <div className=\"space-y-1\">\n                  <h5 className=\"font-bold uppercase text-[9px] text-slate-500 border-b border-slate-200 pb-0.5\">Dados dos Itens de Reposi\303\247\303\243o & M\303\243o de Obra</h5>\n                  <table className=\"w-full text-left text-[9px] border border-black divide-y divide-slate-300\">\n                    <thead className=\"bg-slate-100 font-bold\">\n                      <tr>\n                        <th className=\"p-1\">C\303\263digo</th>\n                        <th className=\"p-1\">Descri\303\247\303\243o</th>\n                        <th className=\"p-1 text-center\">Qtde</th>\n                        <th className=\"p-1 text-right\">Unit\303\241rio</th>\n                        <th className=\"p-1 text-right\">Total item</th>\n                      </tr>\n                    </thead>\n                    <tbody className=\"divide-y divide-slate-200\">\n                      {danfeData.os.usedParts.map((p: any) => (\n                        <tr key={p.partId}>\n                          <td className=\"p-1 font-mono\">{p.partId.slice(0, 10)}</td>\n                          <td className=\"p-1\">{p.name}</td>\n                          <td className=\"p-1 text-center font-mono\">{p.quantity}</td>\n                          <td className=\"p-1 text-right font-mono\">R$ {p.price.toFixed(2)}</td>\n                          <td className=\"p-1 text-right font-mono font-bold\">R$ {(p.price * p.quantity).toFixed(2)}</td>\n                        </tr>\n                      ))}\n                      <tr>\n                        <td className=\"p-1 font-mono\">SUP-SERV</td>\n                        <td className=\"p-1\">\n                          Conserto T\303\251cnico Qualificado: {danfeData.device.type} {danfeData.device.brand} {danfeData.device.model} (S\303\251rie: {danfeData.device.serialNumber})\n                        </td>\n                        <td className=\"p-1 text-center font-mono\">1</td>\n                        <td className=\"p-1 text-right font-mono\">R$ {danfeData.os.laborCost.toFixed(2)}</td>\n                        <td className=\"p-1 text-right font-mono font-bold\">R$ {danfeData.os.laborCost.toFixed(2)}</td>\n                      </tr>\n                    </tbody>\n                  </table>\n                </div>\n\n                {/* 5. TOTAIS DA NOTA */}\n                <div className=\"grid grid-cols-4 gap-2 bg-slate-50 border border-black p-2 rounded\">\n                  <div>\n                    <span className=\"font-bold block text-[8px] text-slate-500\">Base de C\303\241lculo ICMS</span>\n                    <strong className=\"font-mono\">R$ 0,00</strong>\n                  </div>\n                  <div>\n                    <span className=\"font-bold block text-[8px] text-slate-500\">Valor do ICMS Simulado</span>\n                    <strong className=\"font-mono\">R$ 0,00</strong>\n                  </div>\n                  <div>\n                    <span className=\"font-bold block text-[8px] text-slate-500\">Val. Total dos Produtos</span>\n                    <strong className=\"font-mono\">\n                      R$ {danfeData.os.usedParts.reduce((sum: number, i: any) => sum + (i.price * i.quantity), 0).toFixed(2)}\n                    </strong>\n                  </div>\n                  <div className=\"text-right\">\n                    <span className=\"font-bold block text-[8px] text-slate-500\">VALOR TOTAL DA NF-e</span>\n                    <strong className=\"font-mono text-xs text-teal-700\">R$ {danfeData.os.totalCost.toFixed(2)}</strong>\n                  </div>\n                </div>\n\n                {/* Barcode representation */}\n                <div className=\"flex justify-between items-center text-[8px] text-slate-500 border-t border-black pt-3\">\n                  <div>\n                    <p>RESERVADO AO FISCO ESTADUAL DO ESTADO DE S\303\203O PAULO</p>\n                    <p>MGV TECNOLOGIA - EMISS\303\203O FISCAL S\303\215NCRONA VIA BLING V3 INTEGRADA</p>\n                  </div>\n                  <div className=\"text-right font-mono font-bold text-black border border-black p-1 bg-slate-100\">\n                    COD: *29182391283012938012*\n                  </div>\n                </div>\n\n              </div>\n\n            </div>\n          </div>\n        </div>\n      )}\n\n    </div>\n  );\n}\n"
    }
