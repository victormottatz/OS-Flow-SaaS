  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useState, useEffect } from \"react\";\nimport { User, UserRole, Client, Device, OrdemServico, Part } from \"./types\";\nimport Navbar from \"./components/Navbar\";\nimport LoginForm from \"./components/LoginForm\";\nimport DashboardView from \"./components/DashboardView\";\nimport ClientManager from \"./components/ClientManager\";\nimport OSManager from \"./components/OSManager\";\nimport KanbanBoard from \"./components/KanbanBoard\";\nimport BlingSandbox from \"./components/BlingSandbox\";\n\nexport default function App() {\n  // Authentication State\n  const [user, setUser] = useState<User | null>(null);\n  const [token, setToken] = useState<string | null>(null);\n\n  // Core Database Models State\n  const [clients, setClients] = useState<(Client & { devices: Device[] })[]>([]);\n  const [ordensServico, setOrdensServico] = useState<OrdemServico[]>([]);\n  const [parts, setParts] = useState<Part[]>([]);\n\n  // System Controls\n  const [currentTab, setCurrentTab] = useState<string>(\"dashboard\");\n  const [isOffline, setIsOffline] = useState<boolean>(false);\n  const [isInitialized, setIsInitialized] = useState<boolean>(false);\n\n  // Load session from storage\n  useEffect(() => {\n    const savedUser = localStorage.getItem(\"mgv_user\");\n    const savedToken = localStorage.getItem(\"mgv_token\");\n    if (savedUser && savedToken) {\n      setUser(JSON.parse(savedUser));\n      setToken(savedToken);\n    }\n    setIsInitialized(true);\n  }, []);\n\n  // Fetch core models from express server API\n  const loadDatabase = async () => {\n    if (isOffline) return; // Freeze API calls if offline\n\n    try {\n      const [clientsRes, osRes, partsRes] = await Promise.all([\n        fetch(\"/api/clients\"),\n        fetch(\"/api/ordens-servico\"),\n        fetch(\"/api/parts\")\n      ]);\n\n      if (clientsRes.ok && osRes.ok && partsRes.ok) {\n        const clientsData = await clientsRes.json();\n        const osData = await osRes.json();\n        const partsData = await partsRes.json();\n\n        setClients(clientsData);\n        setOrdensServico(osData);\n        setParts(partsData);\n      }\n    } catch (err) {\n      console.error(\"Erro ao sincronizar base de dados Express:\", err);\n    }\n  };\n\n  useEffect(() => {\n    if (user) {\n      loadDatabase();\n    }\n  }, [user, isOffline]);\n\n  const handleLoginSuccess = (loggedInUser: User, sessionToken: string) => {\n    setUser(loggedInUser);\n    setToken(sessionToken);\n    localStorage.setItem(\"mgv_user\", JSON.stringify(loggedInUser));\n    localStorage.setItem(\"mgv_token\", sessionToken);\n    setCurrentTab(\"dashboard\");\n  };\n\n  const handleLogout = () => {\n    setUser(null);\n    setToken(null);\n    localStorage.removeItem(\"mgv_user\");\n    localStorage.removeItem(\"mgv_token\");\n  };\n\n  // Quick Role Switching to test RLS (Soft Delete privileges OWNER vs EDITOR)\n  const handleQuickRoleSwitch = () => {\n    if (!user) return;\n    const nextRole = user.role === UserRole.OWNER ? UserRole.EDITOR : UserRole.OWNER;\n    const updatedUser = { ...user, role: nextRole };\n    setUser(updatedUser);\n    localStorage.setItem(\"mgv_user\", JSON.stringify(updatedUser));\n    alert(`Perfil tempor\303\241rio alterado para: ${nextRole}\\n` + \n      (nextRole === UserRole.EDITOR \n        ? \"Exclus\303\265es l\303\263gicas de Clientes ou OSs retornar\303\243o NEGADO (Permiss\303\243o do Editor).\" \n        : \"Acesso total de exclus\303\243o habilitado (Permiss\303\243o de Dono/Owner).\"\n      )\n    );\n  };\n\n  if (!isInitialized) {\n    return (\n      <div className=\"min-h-screen flex items-center justify-center bg-slate-900 text-white font-mono text-xs\">\n        <span>Iniciando Servidor MGV Tecnologia...</span>\n      </div>\n    );\n  }\n\n  // Not Authenticated Layout\n  if (!user) {\n    return <LoginForm onLoginSuccess={handleLoginSuccess} isOffline={isOffline} />;\n  }\n\n  // Authenticated Dashboard layout viewport\n  return (\n    <div className=\"min-h-screen bg-slate-50 flex flex-col text-slate-800 antialiased font-sans\">\n      <Navbar\n        user={user}\n        currentTab={currentTab}\n        setCurrentTab={setCurrentTab}\n        isOffline={isOffline}\n        setIsOffline={setIsOffline}\n        onLogout={handleLogout}\n        onQuickRoleSwitch={handleQuickRoleSwitch}\n      />\n\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 transition-all\">\n        {currentTab === \"dashboard\" && (\n          <DashboardView\n            clients={clients}\n            devices={clients.flatMap(c => c.devices || [])}\n            ordensServico={ordensServico}\n            parts={parts}\n            isOffline={isOffline}\n            onRefresh={loadDatabase}\n            setCurrentTab={setCurrentTab}\n          />\n        )}\n\n        {currentTab === \"clients\" && (\n          <ClientManager\n            clients={clients}\n            userRole={user.role}\n            isOffline={isOffline}\n            onRefresh={loadDatabase}\n          />\n        )}\n\n        {currentTab === \"os\" && (\n          <OSManager\n            clients={clients}\n            isOffline={isOffline}\n            onRefresh={loadDatabase}\n          />\n        )}\n\n        {currentTab === \"kanban\" && (\n          <KanbanBoard\n            ordensServico={ordensServico}\n            parts={parts}\n            userRole={user.role}\n            isOffline={isOffline}\n            onRefresh={loadDatabase}\n            onNavigateToBlingPanel={() => setCurrentTab(\"bling\")}\n          />\n        )}\n\n        {currentTab === \"bling\" && (\n          <BlingSandbox\n            ordensServico={ordensServico}\n            isOffline={isOffline}\n            onRefresh={loadDatabase}\n          />\n        )}\n      </main>\n\n      <footer className=\"bg-white border-t border-slate-200 py-4 text-center text-xs text-slate-400 font-mono select-none\">\n        <p>MGV Tecnologia & Assist\303\252ncia T\303\251cnica \302\251 {new Date().getFullYear()} \342\200\223 Centralized ERP Workspace</p>\n      </footer>\n    </div>\n  );\n}\n"
    }
