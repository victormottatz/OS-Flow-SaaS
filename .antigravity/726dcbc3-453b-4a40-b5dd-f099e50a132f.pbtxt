    instruction: "Apply Professional Polish layout/color updates to ClientManager.tsx (blue active buttons, input focus ring, and icon accents)."
    replacement_infos {
      original_chunk {
        target_content: "      <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-100 pb-5\">\n        <div>\n          <h2 className=\"text-2xl font-bold text-slate-950 tracking-tight\">Clientes & Equipamentos</h2>\n          <p className=\"text-slate-500 text-sm\">Controle de fichas cadastrais e hist\303\263rico de dispositivos de entrada</p>\n        </div>\n        \n        <button\n          onClick={() => setShowAddModal(true)}\n          className=\"bg-teal-500 hover:bg-teal-600 text-slate-950 font-semibold text-sm px-4 py-2.5 rounded-lg shadow-md transition flex items-center space-x-2 shrink-0\"\n        >\n          <UserPlus className=\"w-4 h-4\" />\n          <span>Cadastrar Cliente</span>\n        </button>\n      </div>\n\n      {/* Search Header */}\n      <div className=\"relative\">\n        <div className=\"absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400\">\n          <Search className=\"w-4 h-4\" />\n        </div>\n        <input\n          type=\"text\"\n          placeholder=\"Filtrar por nome, CPF/CNPJ, e-mail, marca, modelo ou n\302\272 de s\303\251rie do equipamento...\"\n          value={searchTerm}\n          onChange={(e) => setSearchTerm(e.target.value)}\n          className=\"w-full pl-10 pr-4 py-2.5 bg-white border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 placeholder:text-slate-400\"\n        />\n      </div>\n\n      {/* Clients grid layout list */}\n      {filteredClients.length === 0 ? (\n        <div className=\"text-center py-12 bg-white rounded-xl border border-slate-100\">\n          <p className=\"text-slate-500 text-sm\">Nenhum cliente ou aparelho coincide com a pesquisa no momento.</p>\n        </div>\n      ) : (\n        <div className=\"grid grid-cols-1 gap-4\">\n          {filteredClients.map((client) => (\n            <div key={client.id} className=\"bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 flex flex-col md:flex-row justify-between gap-6 hover:shadow-md transition\">\n              {/* Left hand side: Client details */}\n              <div className=\"space-y-3 flex-1\">\n                <div className=\"flex items-center space-x-2\">\n                  <h3 className=\"text-lg font-bold text-slate-900\">{client.name}</h3>\n                  <span className=\"text-xs bg-slate-100 text-slate-600 font-mono px-2 py-0.5 rounded-full\">{client.cpfCnpj}</span>\n                </div>\n                \n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-600\">\n                  <p><strong className=\"text-slate-700\">Telefone:</strong> {client.phone}</p>\n                  <p><strong className=\"text-slate-700\">E-mail:</strong> {client.email}</p>\n                  <p className=\"sm:col-span-2\"><strong className=\"text-slate-700\">Endere\303\247o:</strong> {client.address}</p>\n                </div>\n\n                <div className=\"pt-2 border-t border-slate-50\">\n                  <div className=\"flex items-center justify-between mb-2\">\n                    <span className=\"text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center space-x-1.5\">\n                      <Laptop className=\"w-3.5 h-3.5 text-teal-500\" />\n                      <span>Aparelhos vinculados ({client.devices?.length || 0}):</span>\n                    </span>\n                    \n                    <button\n                      onClick={() => {\n                        setActiveClientForDevice(client.id);\n                        setShowDeviceModal(true);\n                      }}\n                      className=\"text-[11px] font-bold text-teal-600 hover:text-teal-700 flex items-center space-x-0.5\"\n                    >\n                      <Plus className=\"w-3 h-3\" />\n                      <span>Vincular Outro</span>\n                    </button>\n                  </div>\n\n                  {client.devices?.length === 0 ? (\n                    <p className=\"text-xs text-amber-600 italic\">Nenhum aparelho associado \303\240 ficha cadastral.</p>\n                  ) : (\n                    <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                      {client.devices.map((dev) => (\n                        <div key={dev.id} className=\"bg-slate-50 p-3 rounded-lg border border-slate-100/80 text-xs\">\n                          <div className=\"flex items-center justify-between font-semibold text-slate-800\">\n                            <span>{dev.type} ({dev.brand})</span>\n                            <span className={`font-mono text-[10px] uppercase px-1.5 py-0.5 rounded ${\n                              dev.serialNumber === \"Sem S\303\251rie\" ? \"bg-amber-100 text-amber-800\" : \"bg-slate-200 text-slate-700\"\n                            }`}>\n                              N/S: {dev.serialNumber}\n                            </span>\n                          </div>\n                          <p className=\"text-slate-600 mt-1\"><strong className=\"text-slate-700\">Modelo:</strong> {dev.model}</p>\n                          <p className=\"text-slate-500 text-[11px] mt-0.5 pointer-events-none line-clamp-2\" title={dev.description}>\n                            {dev.description}\n                          </p>\n                        </div>\n                      ))}\n                    </div>\n                  )}\n                </div>\n              </div>\n\n              {/* Right hand side: Operations */}\n              <div className=\"flex flex-row md:flex-col justify-end gap-2 shrink-0 pt-4 md:pt-0 border-t md:border-t-0 border-slate-100\">\n                <button\n                  onClick={() => handleDeleteClient(client.id)}\n                  className={`flex items-center justify-center space-x-1.5 px-3 py-2 rounded-lg text-xs font-semibold ${\n                    userRole === UserRole.OWNER\n                      ? \"text-red-700 bg-red-50 hover:bg-red-100 border border-red-200\"\n                      : \"text-slate-400 bg-slate-100 border border-slate-200 cursor-not-allowed\"\n                  }`}\n                  title={userRole !== UserRole.OWNER ? \"Apenas OWNER possui privil\303\251gios de exclusor local\" : \"Excluir cadastro logicamente\"}\n                >\n                  <Trash2 className=\"w-3.5 h-3.5\" />\n                  <span>Excluir Ficha</span>\n                </button>\n              </div>\n            </div>"
