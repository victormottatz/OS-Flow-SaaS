der-indigo-50 pb-1.5\">\n                  <span className=\"bg-slate-900 text-white leading-none rounded-full w-4 h-4 text-[10px] flex items-center justify-center font-mono\">2</span>\n                  <span>Escolha o Aparelho Deixado</span>\n                </h3>\n\n                {availableDevices.length === 0 ? (\n                  <div className=\"bg-amber-50 border border-amber-200 p-3 rounded text-xs text-amber-800\">\n                    O cliente selecionado n\303\243o possui aparelhos vinculados ao cadastro. Por favor, adicione um aparelho nas especifica\303\247\303\265es da ficha do cliente antes.\n                  </div>\n                ) : (\n                  <div>\n                    <label className=\"block text-xs text-slate-500 mb-1 font-semibold\">Equipamentos associados:</label>\n                    <select\n                      required\n                      value={selectedDeviceId}\n                      onChange={(e) => setSelectedDeviceId(e.target.value)}\n                      className=\"w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-500/10\"\n                    >\n                      <option value=\"\">-- Selecione o Dispositivo --</option>\n                      {availableDevices.map((d) => (\n                        <option key={d.id} value={d.id}>\n                          {d.type} {d.brand} {d.model} [S\303\251rie: {d.serialNumber}]\n                        </option>\n                      ))}\n                    </select>\n\n                    {selectedDevice && (\n                      <div className=\"mt-2.5 bg-slate-50 p-3 rounded-lg border border-slate-101 text-xs\">\n                        <p className=\"font-semibold text-slate-800 uppercase text-[9px] tracking-wider mb-1\">Caracter\303\255sticas do aparelho selecionado:</p>\n                        <p className=\"text-slate-600 font-serif italic\">\"{selectedDevice.description}\"</p>\n                      </div>\n                    )}\n                  </div>\n                )}\n              </div>\n            )}\n\n            {/* STEP 3: OS ENTRY PROPERTIES */}\n            {selectedDeviceId && (\n              <div className=\"space-y-4 anim-slideup\">\n                <h3 className=\"text-sm font-bold text-slate-800 uppercase tracking-wider flex items-center space-x-1.5 border-b border-indigo-50 pb-1.5\">\n                  <span className=\"bg-slate-900 text-white leading-none rounded-full w-4 h-4 text-[10px] flex items-center justify-center font-mono\">3</span>\n                  <span>Sintomas e Defeitos Relatados</span>\n                </h3>\n\n                <div className=\"space-y-3.5\">\n                  <div>\n                    <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                      Defeito Relatado pelo Cliente <span className=\"text-red-500\">*</span>\n                    </label>\n                    <textarea\n                      rows={3}\n                      required\n                      placeholder=\"Descreva detalhadamente o sintoma narrado pelo cliente. Ex: Notebook liga mas fica com apitos seguidos e tela completamente preta, superaquecimento repentino.\"\n                      value={reportedDefect}\n                      onChange={(e) => setReportedDefect(e.target.value)}\n                      className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-teal-500\"\n                    />\n                  </div>\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                    <div>\n                      <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Acess\303\263rios Deixados</label>\n                      <input\n                        type=\"text\"\n                        placeholder=\"Ex: Carregador original, cabo USB, capa de prote\303\247\303\243o\"\n                        value={accessoriesLeft}\n                        onChange={(e) => setAccessoriesLeft(e.target.value)}\n                        className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none\"\n                      />\n                    </div>\n\n                    <div>\n                      <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Avarias Est\303\251ticas / Estado no Balc\303\243o</label>\n                      <input\n                        type=\"text\"\n                        placeholder=\"Ex: Tela riscada, aus\303\252ncia de parafuso na carca\303\247a\"\n                        value={physicalState}\n                        onChange={(e) => setPhysicalState(e.target.value)}\n                        className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none\"\n                      />\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"pt-4 border-t border-slate-100 flex justify-end space-x-2\">\n                  <button\n                    type=\"submit\"\n                    disabled={loading}\n                    className=\"bg-slate-900 hover:bg-slate-800 text-white font-semibold text-sm px-5 py-2.5 rounded-lg shadow-md transition flex items-center space-x-2\"\n                  >\n                    <ClipboardPlus className=\"w-4 h-4 text-teal-400\" />\n                    <span>{loading ? \"Registrando Ordem...\" : \"Gerar Ordem e Abrir Termo\"}</span>\n                  </button>\n                </div>\n              </div>\n            )}"
      replacement_content: "            {/* STEP 1: CLIENT SELECTION */}\n            <div className=\"space-y-3\">\n              <h3 className=\"text-sm font-bold text-slate-800 uppercase tracking-wider flex items-center space-x-1.5 border-b border-blue-50 pb-1.5\">\n                <span className=\"bg-blue-600 text-white leading-none rounded-full w-5.5 h-5.5 text-[10px] flex items-center justify-center font-mono font-bold shrink-0\">1</span>\n                <span>Vincular Propriet\303\241rio (Cliente)</span>\n              </h3>\n              \n              <div>\n                <label className=\"block text-xs text-slate-500 mb-1 font-semibold\">Selecione o Cliente Cadastrado:</label>\n                <select\n                  required\n                  value={selectedClientId}\n                  onChange={(e) => {\n                    setSelectedClientId(e.target.value);\n                    setSelectedDeviceId(\"\"); // Reset device\n                  }}\n                  className=\"w-full px-3 py-2.5 bg-white border border-slate-200 rounded-lg text-sm text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-505/20 focus:border-blue-500 transition duration-150\"\n                >\n                  <option value=\"\">-- Selecione o Cliente na Base --</option>\n                  {clients.map((c) => (\n                    <option key={c.id} value={c.id}>\n                      {c.name} ({c.cpfCnpj})\n                    </option>\n                  ))}\n                </select>\n                <p className=\"text-[11px] text-slate-400 mt-1 font-medium\">\n                  Se o cliente for novo, v\303\241 primeiro no menu \"Clientes & Aparelhos\" para registr\303\241-lo.\n                </p>\n              </div>\n            </div>\n\n            {/* STEP 2: DEVICE SELECTION */}\n            {selectedClientId && (\n              <div className=\"space-y-3 anim-slideup\">\n                <h3 className=\"text-sm font-bold text-slate-800 uppercase tracking-wider flex items-center space-x-1.5 border-b border-blue-50 pb-1.5\">\n                  <span className=\"bg-blue-600 text-white leading-none rounded-full w-5.5 h-5.5 text-[10px] flex items-center justify-center font-mono font-bold shrink-0\">2</span>\n                  <span>Escolha o Aparelho Deixado</span>\n                </h3>\n\n                {availableDevices.length === 0 ? (\n                  <div className=\"bg-amber-50 border border-amber-200 p-3 rounded text-xs text-amber-805 font-medium\">\n                    O cliente selecionado n\303\243o possui aparelhos vinculados ao cadastro. Por favor, adicione um aparelho nas especifica\303\247\303\265es da ficha do cliente antes.\n                  </div>\n                ) : (\n                  <div>\n                    <label className=\"block text-xs text-slate-500 mb-1 font-semibold\">Equipamentos associados:</label>\n                    <select\n                      required\n                      value={selectedDeviceId}\n                      onChange={(e) => setSelectedDeviceId(e.target.value)}\n                      className=\"w-full px-3 py-2.5 bg-white border border-slate-200 rounded-lg text-sm text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-blue-505/20 focus:border-blue-500 transition duration-150\"\n                    >\n                      <option value=\"\">-- Selecione o Dispositivo --</option>\n                      {availableDevices.map((d) => (\n                        <option key={d.id} value={d.id}>\n                          {d.type} {d.brand} {d.model} [S\303\251rie: {d.serialNumber}]\n                        </option>\n                      ))}\n                    </select>\n\n                    {selectedDevice && (\n                      <div className=\"mt-2.5 bg-slate-50 p-3 rounded-lg border border-slate-150 text-xs\">\n                        <p className=\"font-bold text-slate-800 uppercase text-[9px] tracking-wider mb-1\">Caracter\303\255sticas do aparelho selecionado:</p>\n                        <p className=\"text-slate-600 font-serif italic\">\"{selectedDevice.description}\"</p>\n                      </div>\n                    )}\n                  </div>\n                )}\n              </div>\n            )}\n\n            {/* STEP 3: OS ENTRY PROPERTIES */}\n            {selectedDeviceId && (\n              <div className=\"space-y-4 anim-slideup\">\n                <h3 className=\"text-sm font-bold text-slate-800 uppercase tracking-wider flex items-center space-x-1.5 border-b border-blue-50 pb-1.5\">\n                  <span className=\"bg-blue-600 text-white leading-none rounded-full w-5.5 h-5.5 text-[10px] flex items-center justify-center font-mono font-bold shrink-0\">3</span>\n                  <span>Sintomas e Defeitos Relatados</span>\n                </h3>\n\n                <div className=\"space-y-3.5\">\n                  <div>\n                    <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                      Defeito Relatado pelo Cliente <span className=\"text-red-500\">*</span>\n                    </label>\n                    <textarea\n                      rows={3}\n                      required\n                      placeholder=\"Descreva detalhadamente o sintoma narrado pelo cliente. Ex: Notebook liga mas fica com apitos seguidos e tela completamente preta, superaquecimento repentino.\"\n                      value={reportedDefect}\n                      onChange={(e) => setReportedDefect(e.target.value)}\n                      className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-505/20 focus:border-blue-500 font-medium transition\"\n                    />\n                  </div>\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                    <div>\n                      <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Acess\303\263rios Deixados</label>\n                      <input\n                        type=\"text\"\n                        placeholder=\"Ex: Carregador original, cabo USB, capa de prote\303\247\303\243o\"\n                        value={accessoriesLeft}\n                        onChange={(e) => setAccessoriesLeft(e.target.value)}\n                        className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-505/20 focus:border-blue-500 font-medium transition\"\n                      />\n                    </div>\n\n                    <div>\n                      <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Avarias Est\303\251ticas / Estado no Balc\303\243o</label>\n                      <input\n                        type=\"text\"\n                        placeholder=\"Ex: Tela riscada, aus\303\252ncia de parafuso na carca\303\247a\"\n                        value={physicalState}\n                        onChange={(e) => setPhysicalState(e.target.value)}\n                        className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-505/20 focus:border-blue-500 font-medium transition\"\n                      />\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"pt-4 border-t border-slate-100 flex justify-end space-x-2\">\n                  <button\n                    type=\"submit\"\n                    disabled={loading}\n                    className=\"bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-bold text-sm px-5 py-2.5 rounded-lg shadow-sm transition flex items-center space-x-2 shrink-0\"\n                  >\n                    <ClipboardPlus className=\"w-4 h-4 text-blue-105\" />\n                    <span>{loading ? \"Registrando Ordem...\" : \"Gerar Ordem e Abrir Termo\"}</span>\n            