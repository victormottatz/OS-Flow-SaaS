  file_change {
    absolute_path_uri: "file:///src/components/ClientManager.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useState } from \"react\";\nimport { Client, Device, UserRole } from \"../types\";\nimport { \n  UserPlus, Search, Smartphone, ShieldAlert, BadgeInfo, Trash2, Edit, Plus, X, Laptop, CheckCircle\n} from \"lucide-react\";\n\ninterface ClientManagerProps {\n  clients: (Client & { devices: Device[] })[];\n  userRole: UserRole;\n  isOffline: boolean;\n  onRefresh: () => void;\n}\n\nexport default function ClientManager({ clients, userRole, isOffline, onRefresh }: ClientManagerProps) {\n  const [searchTerm, setSearchTerm] = useState(\"\");\n  const [showAddModal, setShowAddModal] = useState(false);\n  const [showDeviceModal, setShowDeviceModal] = useState(false);\n  const [activeClientForDevice, setActiveClientForDevice] = useState<string | null>(null);\n\n  // Form Fields - Client\n  const [clientName, setClientName] = useState(\"\");\n  const [clientCpfCnpj, setClientCpfCnpj] = useState(\"\");\n  const [clientPhone, setClientPhone] = useState(\"\");\n  const [clientEmail, setClientEmail] = useState(\"\");\n  const [clientAddress, setClientAddress] = useState(\"\");\n  \n  // Custom list of devices inside the Add Client modal\n  const [tempDevices, setTempDevices] = useState<{ type: string; brand: string; model: string; serialNumber: string; description: string }[]>([]);\n\n  // Form Fields - Individual Device addition\n  const [devType, setDevType] = useState(\"Notebook\");\n  const [devBrand, setDevBrand] = useState(\"\");\n  const [devModel, setDevModel] = useState(\"\");\n  const [devSerial, setDevSerial] = useState(\"\");\n  const [devDesc, setDevDesc] = useState(\"\");\n\n  const [errorMsg, setErrorMsg] = useState(\"\");\n  const [successMsg, setSuccessMsg] = useState(\"\");\n  const [loading, setLoading] = useState(false);\n\n  // Helper validation for CPF/CNPJ\n  const formatCpfCnpj = (val: string) => {\n    // Basic format filter\n    return val.replace(/\\D/g, \"\");\n  };\n\n  const addTempDeviceField = () => {\n    setTempDevices([...tempDevices, { type: \"Notebook\", brand: \"\", model: \"\", serialNumber: \"\", description: \"\" }]);\n  };\n\n  const updateTempDevice = (index: number, field: string, value: string) => {\n    const updated = [...tempDevices];\n    updated[index] = { ...updated[index], [field]: value };\n    setTempDevices(updated);\n  };\n\n  const removeTempDevice = (index: number) => {\n    setTempDevices(tempDevices.filter((_, idx) => idx !== index));\n  };\n\n  const handleCreateClient = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(\"\");\n    setSuccessMsg(\"\");\n\n    if (isOffline) {\n      setErrorMsg(\"O sistema est\303\241 offline. Conex\303\243o f\303\255sica de rede indispon\303\255vel.\");\n      return;\n    }\n\n    if (!clientName || !clientCpfCnpj || !clientPhone || !clientEmail || !clientAddress) {\n      setErrorMsg(\"Todos os campos do cliente s\303\243o de preenchimento obrigat\303\263rio.\");\n      return;\n    }\n\n    // Validation for \"Sem S\303\251rie\" description length minimum\n    for (const [idx, dev] of tempDevices.entries()) {\n      const isBlankSerial = !dev.serialNumber || dev.serialNumber.trim() === \"\" || dev.serialNumber === \"Sem S\303\251rie\";\n      if (isBlankSerial && (!dev.description || dev.description.trim().length < 5)) {\n        setErrorMsg(`Para o equipamento n\302\272 ${idx + 1} sem n\303\272mero de s\303\251rie, \303\251 obrigat\303\263rio preencher uma descri\303\247\303\243o detalhada das caracter\303\255sticas est\303\251ticas/f\303\255sicas.`);\n        return;\n      }\n    }\n\n    setLoading(true);\n\n    try {\n      const response = await fetch(\"/api/clients\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          name: clientName,\n          cpfCnpj: clientCpfCnpj,\n          phone: clientPhone,\n          email: clientEmail,\n          address: clientAddress,\n          devices: tempDevices\n        })\n      });\n\n      const data = await response.json();\n\n      if (!response.ok) {\n        throw new Error(data.error || \"Erro ao salvar cliente.\");\n      }\n\n      setSuccessMsg(\"Cliente e seus respectivos aparelhos cadastrados com excel\303\252ncia!\");\n      onRefresh();\n      \n      // Cleanup\n      setTimeout(() => {\n        setShowAddModal(false);\n        setClientName(\"\");\n        setClientCpfCnpj(\"\");\n        setClientPhone(\"\");\n        setClientEmail(\"\");\n        setClientAddress(\"\");\n        setTempDevices([]);\n        setSuccessMsg(\"\");\n      }, 1500);\n\n    } catch (err: any) {\n      setErrorMsg(err.message || \"Erro inesperado.\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleAddIndividualDevice = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(\"\");\n    setSuccessMsg(\"\");\n\n    if (isOffline) {\n      setErrorMsg(\"Aparelho n\303\243o p\303\264de ser gravado: Sistema offline.\");\n      return;\n    }\n\n    const resolvedSerial = devSerial.trim() === \"\" ? \"Sem S\303\251rie\" : devSerial.trim();\n    if (resolvedSerial === \"Sem S\303\251rie\" && (!devDesc || devDesc.trim().length < 5)) {\n      setErrorMsg(\"Para equipamentos sem n\303\272mero de s\303\251rie, descreva caracter\303\255sticas est\303\251ticas detalhadas (ex: marcas de uso, etiquetas, adesivos).\");\n      return;\n    }\n\n    setLoading(true);\n\n    try {\n      const response = await fetch(\"/api/devices\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          clientId: activeClientForDevice,\n          type: devType,\n          brand: devBrand,\n          model: devModel,\n          serialNumber: resolvedSerial,\n          description: devDesc\n        })\n      });\n\n      const data = await response.json();\n\n      if (!response.ok) {\n        throw new Error(data.error || \"Erro ao associar dispositivo.\");\n      }\n\n      setSuccessMsg(\"Dispositivo adicionado \303\240 conta do cliente!\");\n      onRefresh();\n\n      setTimeout(() => {\n        setShowDeviceModal(false);\n        setActiveClientForDevice(null);\n        setDevBrand(\"\");\n        setDevModel(\"\");\n        setDevSerial(\"\");\n        setDevDesc(\"\");\n        setSuccessMsg(\"\");\n      }, 1200);\n\n    } catch (err: any) {\n      setErrorMsg(err.message || \"Erro inesperado.\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleDeleteClient = async (id: string) => {\n    if (isOffline) {\n      alert(\"Opera\303\247\303\243o impossibilitada: Modo Offline ativo.\");\n      return;\n    }\n\n    if (userRole !== UserRole.OWNER) {\n      alert(\"Acesso Negado: Apenas a fun\303\247\303\243o OWNER possui permiss\303\243o para excluir clientes e ativos.\");\n      return;\n    }\n\n    if (!confirm(\"Aviso: Esta exclus\303\243o \303\251 l\303\263gica (Soft Delete) e tornar\303\241 o cliente e todas as suas OSs inacess\303\255veis para edi\303\247\303\243o. Deseja prosseguir de forma definitiva?\")) {\n      return;\n    }\n\n    try {\n      const response = await fetch(`/api/clients/${id}`, {\n        method: \"DELETE\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          \"x-user-role\": userRole\n        }\n      });\n\n      if (!response.ok) {\n        const errorData = await response.json();\n        throw new Error(errorData.error || \"N\303\243o foi poss\303\255vel excluir\");\n      }\n\n      alert(\"Exclus\303\243o l\303\263gica realizada com sucesso!\");\n      onRefresh();\n    } catch (err: any) {\n      alert(err.message);\n    }\n  };\n\n  // Filter lists based on search\n  const filteredClients = clients.filter(c => {\n    const searchLow = searchTerm.toLowerCase();\n    const hasMatch = c.name.toLowerCase().includes(searchLow) || \n                     c.cpfCnpj.includes(searchLow) || \n                     c.email.toLowerCase().includes(searchLow) ||\n                     c.devices.some(d => d.brand.toLowerCase().includes(searchLow) || d.model.toLowerCase().includes(searchLow) || d.serialNumber.toLowerCase().includes(searchLow));\n    return hasMatch;\n  });\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-100 pb-5\">\n        <div>\n          <h2 className=\"text-2xl font-bold text-slate-950 tracking-tight\">Clientes & Equipamentos</h2>\n          <p className=\"text-slate-500 text-sm\">Controle de fichas cadastrais e hist\303\263rico de dispositivos de entrada</p>\n        </div>\n        \n        <button\n          onClick={() => setShowAddModal(true)}\n          className=\"bg-teal-500 hover:bg-teal-600 text-slate-950 font-semibold text-sm px-4 py-2.5 rounded-lg shadow-md transition flex items-center space-x-2 shrink-0\"\n        >\n          <UserPlus className=\"w-4 h-4\" />\n          <span>Cadastrar Cliente</span>\n        </button>\n      </div>\n\n      {/* Search Header */}\n      <div className=\"relative\">\n        <div className=\"absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400\">\n          <Search className=\"w-4 h-4\" />\n        </div>\n        <input\n          type=\"text\"\n          placeholder=\"Filtrar por nome, CPF/CNPJ, e-mail, marca, modelo ou n\302\272 de s\303\251rie do equipamento...\"\n          value={searchTerm}\n          onChange={(e) => setSearchTerm(e.target.value)}\n          className=\"w-full pl-10 pr-4 py-2.5 bg-white border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 placeholder:text-slate-400\"\n        />\n      </div>\n\n      {/* Clients grid layout list */}\n      {filteredClients.length === 0 ? (\n        <div className=\"text-center py-12 bg-white rounded-xl border border-slate-100\">\n          <p className=\"text-slate-500 text-sm\">Nenhum cliente ou aparelho coincide com a pesquisa no momento.</p>\n        </div>\n      ) : (\n        <div className=\"grid grid-cols-1 gap-4\">\n          {filteredClients.map((client) => (\n            <div key={client.id} className=\"bg-white rounded-xl border border-slate-200/80 shadow-sm p-6 flex flex-col md:flex-row justify-between gap-6 hover:shadow-md transition\">\n              {/* Left hand side: Client details */}\n              <div className=\"space-y-3 flex-1\">\n                <div className=\"flex items-center space-x-2\">\n                  <h3 className=\"text-lg font-bold text-slate-900\">{client.name}</h3>\n                  <span className=\"text-xs bg-slate-100 text-slate-600 font-mono px-2 py-0.5 rounded-full\">{client.cpfCnpj}</span>\n                </div>\n                \n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-600\">\n                  <p><strong className=\"text-slate-700\">Telefone:</strong> {client.phone}</p>\n                  <p><strong className=\"text-slate-700\">E-mail:</strong> {client.email}</p>\n                  <p className=\"sm:col-span-2\"><strong className=\"text-slate-700\">Endere\303\247o:</strong> {client.address}</p>\n                </div>\n\n                <div className=\"pt-2 border-t border-slate-50\">\n                  <div className=\"flex items-center justify-between mb-2\">\n                    <span className=\"text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center space-x-1.5\">\n                      <Laptop className=\"w-3.5 h-3.5 text-teal-500\" />\n                      <span>Aparelhos vinculados ({client.devices?.length || 0}):</span>\n                    </span>\n                    \n                    <button\n                      onClick={() => {\n                        setActiveClientForDevice(client.id);\n                        setShowDeviceModal(true);\n                      }}\n                      className=\"text-[11px] font-bold text-teal-600 hover:text-teal-700 flex items-center space-x-0.5\"\n                    >\n                      <Plus className=\"w-3 h-3\" />\n                      <span>Vincular Outro</span>\n                    </button>\n                  </div>\n\n                  {client.devices?.length === 0 ? (\n                    <p className=\"text-xs text-amber-600 italic\">Nenhum aparelho associado \303\240 ficha cadastral.</p>\n                  ) : (\n                    <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n                      {client.devices.map((dev) => (\n                        <div key={dev.id} className=\"bg-slate-50 p-3 rounded-lg border border-slate-100/80 text-xs\">\n                          <div className=\"flex items-center justify-between font-semibold text-slate-800\">\n                            <span>{dev.type} ({dev.brand})</span>\n                            <span className={`font-mono text-[10px] uppercase px-1.5 py-0.5 rounded ${\n                              dev.serialNumber === \"Sem S\303\251rie\" ? \"bg-amber-100 text-amber-800\" : \"bg-slate-200 text-slate-700\"\n                            }`}>\n                              N/S: {dev.serialNumber}\n                            </span>\n                          </div>\n                          <p className=\"text-slate-600 mt-1\"><strong className=\"text-slate-700\">Modelo:</strong> {dev.model}</p>\n                          <p className=\"text-slate-500 text-[11px] mt-0.5 pointer-events-none line-clamp-2\" title={dev.description}>\n                            {dev.description}\n                          </p>\n                        </div>\n                      ))}\n                    </div>\n                  )}\n                </div>\n              </div>\n\n              {/* Right hand side: Operations */}\n              <div className=\"flex flex-row md:flex-col justify-end gap-2 shrink-0 pt-4 md:pt-0 border-t md:border-t-0 border-slate-100\">\n                <button\n                  onClick={() => handleDeleteClient(client.id)}\n                  className={`flex items-center justify-center space-x-1.5 px-3 py-2 rounded-lg text-xs font-semibold ${\n                    userRole === UserRole.OWNER\n                      ? \"text-red-700 bg-red-50 hover:bg-red-100 border border-red-200\"\n                      : \"text-slate-400 bg-slate-100 border border-slate-200 cursor-not-allowed\"\n                  }`}\n                  title={userRole !== UserRole.OWNER ? \"Apenas OWNER possui privil\303\251gios de exclusor local\" : \"Excluir cadastro logicamente\"}\n                >\n                  <Trash2 className=\"w-3.5 h-3.5\" />\n                  <span>Excluir Ficha</span>\n                </button>\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n\n      {/* MODAL: ADD CLIENT & LINKED DEVICES */}\n      {showAddModal && (\n        <div className=\"fixed inset-0 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center p-4 z-50 overflow-y-auto\">\n          <div className=\"bg-white rounded-xl shadow-2xl border border-slate-100 w-full max-w-2xl max-h-[90vh] overflow-y-auto\">\n            {/* Header */}\n            <div className=\"px-6 py-4 bg-slate-900 text-white flex items-center justify-between rounded-t-xl sticky top-0 z-10\">\n              <div className=\"flex items-center space-x-2\">\n                <UserPlus className=\"w-5 h-5 text-teal-400\" />\n                <h3 className=\"font-bold text-lg\">Novo Cadastro de Cliente e V\303\255nculo 1:N</h3>\n              </div>\n              <button onClick={() => setShowAddModal(false)} className=\"text-slate-400 hover:text-white transition\">\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            {/* Form */}\n            <form onSubmit={handleCreateClient} className=\"p-6 space-y-6\">\n              {errorMsg && (\n                <div className=\"bg-red-50 border-l-4 border-red-500 p-3 rounded text-xs text-red-700 flex items-start space-x-2\">\n                  <ShieldAlert className=\"w-4 h-4 shrink-0 mt-0.5\" />\n                  <span>{errorMsg}</span>\n                </div>\n              )}\n\n              {successMsg && (\n                <div className=\"bg-green-50 border-l-4 border-green-500 p-3 rounded text-xs text-green-700 flex items-start space-x-2\">\n                  <CheckCircle className=\"w-4 h-4 shrink-0 mt-0.5\" />\n                  <span>{successMsg}</span>\n                </div>\n              )}\n\n              <div className=\"space-y-4\">\n                <h4 className=\"text-xs font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-1\">Ficha ID / Propriet\303\241rio</h4>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <div>\n                    <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Nome Completo</label>\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder=\"Ex: Carlos Roberto Silva\"\n                      value={clientName}\n                      onChange={(e) => setClientName(e.target.value)}\n                      className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500\"\n                    />\n                  </div>\n                  <div>\n                    <label className=\"block text-xs font-semibold text-slate-700 mb-1\">CPF / CNPJ (Somente N\303\272meros)</label>\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder=\"Ex: 14259388210\"\n                      value={clientCpfCnpj}\n                      onChange={(e) => setClientCpfCnpj(e.target.value)}\n                      className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500\"\n                    />\n                  </div>\n                  <div>\n                    <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Telefone / Fone Oficina</label>\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder=\"Ex: (11) 98112-2233\"\n                      value={clientPhone}\n                      onChange={(e) => setClientPhone(e.target.value)}\n                      className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500\"\n                    />\n                  </div>\n                  <div>\n                    <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Email Principal</label>\n                    <input\n                      type=\"email\"\n                      required\n                      placeholder=\"Ex: carlos@silva.com\"\n                      value={clientEmail}\n                      onChange={(e) => setClientEmail(e.target.value)}\n                      className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500\"\n                    />\n                  </div>\n                  <div className=\"sm:col-span-2\">\n                    <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Endere\303\247o Residencial/Comercial Completo</label>\n                    <input\n                      type=\"text\"\n                      required\n                      placeholder=\"Ex: Av. Paulista, 1000 - Ap 21 - CEP 01310-100, S\303\243o Paulo SP\"\n                      value={clientAddress}\n                      onChange={(e) => setClientAddress(e.target.value)}\n                      className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500\"\n                    />\n                  </div>\n                </div>\n              </div>\n\n              {/* Devices 1:N Sub-entry */}\n              <div className=\"space-y-4 pt-2\">\n                <div className=\"flex items-center justify-between border-b border-slate-100 pb-1\">\n                  <h4 className=\"text-xs font-bold text-slate-800 uppercase tracking-wider\">Aparelhos Iniciais a Registrar</h4>\n                  <button\n                    type=\"button\"\n                    onClick={addTempDeviceField}\n                    className=\"text-xs font-bold text-teal-600 hover:text-teal-700 flex items-center space-x-1\"\n                  >\n                    <Plus className=\"w-3.5 h-3.5\" />\n                    <span>Adicionar Linha</span>\n                  </button>\n                </div>\n\n                {tempDevices.length === 0 ? (\n                  <div className=\"text-center py-6 bg-slate-50 rounded-lg border border-dashed border-slate-200\">\n                    <p className=\"text-slate-500 text-xs\">Nenhum aparelho adicionado \303\240 ficha inicial de abertura.</p>\n                    <button\n                      type=\"button\"\n                      onClick={addTempDeviceField}\n                      className=\"mt-2 text-xs font-semibold text-teal-600 hover:underline\"\n                    >\n                      Registrar 1\302\272 Equipamento Agora\n                    </button>\n                  </div>\n                ) : (\n                  <div className=\"space-y-4\">\n                    {tempDevices.map((dev, idx) => (\n                      <div key={idx} className=\"bg-slate-50 rounded-lg border border-slate-200 p-4 relative space-y-3\">\n                        <button\n                          type=\"button\"\n                          onClick={() => removeTempDevice(idx)}\n                          className=\"absolute top-2 right-2 text-slate-400 hover:text-red-500 transition\"\n                        >\n                          <X className=\"w-4 h-4\" />\n                        </button>\n                        \n                        <span className=\"text-[10px] font-bold bg-slate-800 text-white rounded px-2 py-0.5\">\n                          Aparelho #{idx + 1}\n                        </span>\n\n                        <div className=\"grid grid-cols-1 sm:grid-cols-4 gap-3\">\n                          <div>\n                            <label className=\"block text-[11px] font-semibold text-slate-600 mb-0.5\">Tipo de Equipamento</label>\n                            <select\n                              value={dev.type}\n                              onChange={(e) => updateTempDevice(idx, \"type\", e.target.value)}\n                              className=\"w-full px-2 py-1.5 border border-slate-200 rounded bg-white text-xs text-slate-800\"\n                            >\n                              <option value=\"Notebook\">Notebook</option>\n                              <option value=\"Computador Desktop\">Computador Desktop</option>\n                              <option value=\"Impressora\">Impressora</option>\n                              <option value=\"Monitor LCD\">Monitor LCD</option>\n                              <option value=\"Video Game Console\">V\303\255deo Game / Console</option>\n                              <option value=\"Smart TV\">Smart TV</option>\n                              <option value=\"Outro\">Outro Equipamento</option>\n                            </select>\n                          </div>\n                          <div>\n                            <label className=\"block text-[11px] font-semibold text-slate-600 mb-0.5\">Marca</label>\n                            <input\n                              type=\"text\"\n                              required\n                              placeholder=\"Ex: LG, Dell, Epson\"\n                              value={dev.brand}\n                              onChange={(e) => updateTempDevice(idx, \"brand\", e.target.value)}\n                              className=\"w-full px-2 py-1.5 border border-slate-200 rounded text-xs text-slate-800\"\n                            />\n                          </div>\n                          <div>\n                            <label className=\"block text-[11px] font-semibold text-slate-600 mb-0.5\">Modelo</label>\n                            <input\n                              type=\"text\"\n                              required\n                              placeholder=\"Ex: Inspiron 14\"\n                              value={dev.model}\n                              onChange={(e) => updateTempDevice(idx, \"model\", e.target.value)}\n                              className=\"w-full px-2 py-1.5 border border-slate-200 rounded text-xs text-slate-800\"\n                            />\n                          </div>\n                          <div>\n                            <label className=\"block text-[11px] font-semibold text-slate-600 mb-0.5\">N\302\272 de S\303\251rie</label>\n                            <input\n                              type=\"text\"\n                              placeholder=\"Deixe em branco para \'Sem S\303\251rie\'\"\n                              value={dev.serialNumber}\n                              onChange={(e) => updateTempDevice(idx, \"serialNumber\", e.target.value)}\n                              className=\"w-full px-2 py-1.5 border border-slate-200 rounded text-xs text-slate-800 font-mono\"\n                            />\n                          </div>\n                        </div>\n\n                        <div>\n                          <label className=\"block text-[11px] font-semibold text-slate-600 mb-0.5 flex items-center space-x-1\">\n                            <span>Estado F\303\255sico / Especifica\303\247\303\265es</span>\n                            <span className=\"text-slate-400 font-normal\">(Exigido se s/ n\303\272mero de s\303\251rie)</span>\n                          </label>\n                          <textarea\n                            rows={2}\n                            placeholder=\"Descreva marcas est\303\251ticas, riscos, avarias ou aus\303\252ncia de travas para garantir a integridade.\"\n                            value={dev.description}\n                            onChange={(e) => updateTempDevice(idx, \"description\", e.target.value)}\n                            className=\"w-full px-2.5 py-1.5 border border-slate-200 rounded text-xs focus:outline-none focus:ring-1 focus:ring-teal-500\"\n                          />\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                )}\n              </div>\n\n              {/* Actions Footer */}\n              <div className=\"flex justify-end space-x-2 border-t border-slate-100 pt-4\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowAddModal(false)}\n                  className=\"px-4 py-2 border border-slate-200 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-50 transition\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  disabled={loading}\n                  className=\"px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white font-semibold text-sm rounded-lg transition\"\n                >\n                  {loading ? \"Gravando Fichas no Banco...\" : \"Salvar no Supabase\"}\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n\n      {/* MODAL: ADD INDIVIDUAL DEVICE */}\n      {showDeviceModal && (\n        <div className=\"fixed inset-0 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center p-4 z-50\">\n          <div className=\"bg-white rounded-xl shadow-2xl border border-slate-100 w-full max-w-md\">\n            <div className=\"px-6 py-4 bg-slate-900 text-white flex items-center justify-between rounded-t-xl\">\n              <div className=\"flex items-center space-x-2\">\n                <Laptop className=\"w-5 h-5 text-teal-400\" />\n                <h3 className=\"font-bold\">Vincular Novo Aparelho ao Cliente</h3>\n              </div>\n              <button onClick={() => setShowDeviceModal(false)} className=\"text-slate-400 hover:text-white transition\">\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            <form onSubmit={handleAddIndividualDevice} className=\"p-6 space-y-4\">\n              {errorMsg && (\n                <div className=\"bg-red-50 border-l-4 border-red-500 p-2 rounded text-xs text-red-700\">\n                  {errorMsg}\n                </div>\n              )}\n\n              {successMsg && (\n                <div className=\"bg-green-50 border-l-4 border-green-500 p-2 rounded text-xs text-green-700\">\n                  {successMsg}\n                </div>\n              )}\n\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Tipo de Aparelho</label>\n                <select\n                  value={devType}\n                  onChange={(e) => setDevType(e.target.value)}\n                  className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white\"\n                >\n                  <option value=\"Notebook\">Notebook</option>\n                  <option value=\"Computador Desktop\">Computador Desktop</option>\n                  <option value=\"Impressora\">Impressora</option>\n                  <option value=\"Monitor LCD\">Monitor LCD</option>\n                  <option value=\"Video Game Console\">V\303\255deo Game / Console</option>\n                  <option value=\"Smart TV\">Smart TV</option>\n                  <option value=\"Outro\">Outro</option>\n                </select>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Marca</label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"Ex: Dell, Samsung\"\n                  value={devBrand}\n                  onChange={(e) => setDevBrand(e.target.value)}\n                  className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Modelo</label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"Ex: Inspiron 15\"\n                  value={devModel}\n                  onChange={(e) => setDevModel(e.target.value)}\n                  className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 mb-1\">N\303\272mero de S\303\251rie (Deixar branco p/ \"Sem S\303\251rie\")</label>\n                <input\n                  type=\"text\"\n                  placeholder=\"Deixe em branco se Sem S\303\251rie\"\n                  value={devSerial}\n                  onChange={(e) => setDevSerial(e.target.value)}\n                  className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm font-mono\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                  Caracter\303\255sticas F\303\255sicas / Estado (Exigido se Sem S\303\251rie)\n                </label>\n                <textarea\n                  rows={3}\n                  required={devSerial.trim() === \"\"}\n                  placeholder=\"Descreva marcas, riscos ou quebras est\303\251ticas fundamentais para a responsabilidade jur\303\255dica t\303\251cnica da MGV.\"\n                  value={devDesc}\n                  onChange={(e) => setDevDesc(e.target.value)}\n                  className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-500/20\"\n                />\n              </div>\n\n              <div className=\"flex justify-end space-x-2 pt-3 border-t border-slate-50\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowDeviceModal(false)}\n                  className=\"px-4 py-2 border border-slate-200 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-50\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  disabled={loading}\n                  className=\"px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white font-semibold text-sm rounded-lg\"\n                >\n                  {loading ? \"Gravando...\" : \"Salvar Aparelho\"}\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n\n    </div>\n  );\n}\n"
