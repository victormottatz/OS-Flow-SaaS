    instruction: "Configure corporate theme formatting, icon colors, and printing trigger buttons in BlingSandbox.tsx."
    replacement_infos {
      original_chunk {
        target_content: "      {/* API Reference table from Specification */}\n      <div className=\"bg-slate-50 rounded-lg p-5 border border-slate-200 mt-6 text-xs text-slate-600\">\n        <h4 className=\"font-bold text-slate-800 uppercase text-[10px] tracking-wider mb-2 flex items-center space-x-1\">\n          <HelpIcon className=\"w-3.5 h-3.5 text-teal-600\" />\n          <span>Tabela de Refer\303\252ncia Fiscal (C\303\263digos de Opera\303\247\303\243o Bling API V3)</span>\n        </h4>\n        <div className=\"grid grid-cols-1 md:grid-cols-5 gap-3 mt-3\">\n          <div className=\"bg-white p-2.5 rounded border border-slate-200/50\">\n            <span className=\"font-mono font-bold text-emerald-700 block text-xs\">200 OK</span>\n            <span className=\"text-[10px] text-slate-500\">Sucesso na gera\303\247\303\243o fiscal SEFAZ.</span>\n          </div>\n          <div className=\"bg-white p-2.5 rounded border border-slate-200/50\">\n            <span className=\"font-mono font-bold text-amber-700 block text-xs\">400 Bad Request</span>\n            <span className=\"text-[10px] text-slate-500\">Invalidez de digita\303\247\303\243o documental.</span>\n          </div>\n          <div className=\"bg-white p-2.5 rounded border border-slate-200/50\">\n            <span className=\"font-mono font-bold text-red-700 block text-xs\">401 Unauthorized</span>\n            <span className=\"text-[10px] text-slate-500\">Chave API Bling desatualizada.</span>\n          </div>\n          <div className=\"bg-white p-2.5 rounded border border-slate-200/50\">\n            <span className=\"font-mono font-bold text-red-700 block text-xs\">422 Unproc Entity</span>\n            <span className=\"text-[10px] text-slate-500\">Nota rejeitada pela SEFAZ de destino.</span>\n          </div>\n          <div className=\"bg-white p-2.5 rounded border border-slate-200/50\">\n            <span className=\"font-mono font-bold text-purple-700 block text-xs\">503 Service Down</span>\n            <span className=\"text-[10px] text-slate-500\">Servidores do posto fiscal offline.</span>\n          </div>\n        </div>\n      </div>\n\n      {/* DANFE MODAL PREVIEW ON SCREEN */}\n      {activeDanfeOS && danfeData && (\n        <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 z-50 overflow-y-auto\">\n          <div className=\"bg-white rounded-xl shadow-2xl border border-slate-200 w-full max-w-4xl max-h-[95vh] overflow-y-auto flex flex-col\">\n            \n            {/* Modal header with options */}\n            <div className=\"p-4 bg-slate-900 text-white flex items-center justify-between sticky top-0 z-10\">\n              <div className=\"flex items-center space-x-2\">\n                <FileText className=\"w-5 h-5 text-teal-400\" />\n                <h3 className=\"font-bold\">DANFE - Documento Auxiliar da Nota Fiscal Eletr\303\264nica</h3>\n              </div>\n              <div className=\"flex items-center space-x-2\">\n                <button\n                  onClick={() => window.print()}\n                  className=\"bg-teal-500 hover:bg-teal-600 text-slate-950 font-bold px-3 py-1.5 rounded-lg text-xs flex items-center space-x-1.5 transition\"\n                >\n                  <Printer className=\"w-3.5 h-3.5\" />\n                  <span>Imprimir NFe</span>\n                </button>\n                <button onClick={() => { setActiveDanfeOS(null); setDanfeData(null); }} className=\"text-slate-400 hover:text-white transition\">\n                  <X className=\"w-5 h-5\" />\n                </button>\n              </div>\n            </div>"
        replacement_content: "      {/* API Reference table from Specification */}\n      <div className=\"bg-slate-50 rounded-xl p-5 border border-slate-200 mt-6 text-xs text-slate-650 shadow-sm\">\n        <h4 className=\"font-bold text-slate-800 uppercase text-[10px] tracking-wider mb-2 flex items-center space-x-1.5\">\n          <HelpIcon className=\"w-3.5 h-3.5 text-blue-600\" />\n          <span>Tabela de Refer\303\252ncia Fiscal (C\303\263digos de Opera\303\247\303\243o Bling API V3)</span>\n        </h4>\n        <div className=\"grid grid-cols-1 md:grid-cols-5 gap-3 mt-3\">\n          <div className=\"bg-white p-2.5 rounded-lg border border-slate-200/50\">\n            <span className=\"font-mono font-bold text-emerald-700 block text-xs\">200 OK</span>\n            <span className=\"text-[10px] text-slate-500\">Sucesso na gera\303\247\303\243o fiscal SEFAZ.</span>\n          </div>\n          <div className=\"bg-white p-2.5 rounded-lg border border-slate-200/50\">\n            <span className=\"font-mono font-bold text-amber-700 block text-xs\">400 Bad Request</span>\n            <span className=\"text-[10px] text-slate-500\">Invalidez de digita\303\247\303\243o documental.</span>\n          </div>\n          <div className=\"bg-white p-2.5 rounded-lg border border-slate-200/50\">\n            <span className=\"font-mono font-bold text-red-700 block text-xs\">401 Unauthorized</span>\n            <span className=\"text-[10px] text-slate-500\">Chave API Bling desatualizada.</span>\n          </div>\n          <div className=\"bg-white p-2.5 rounded-lg border border-slate-200/50\">\n            <span className=\"font-mono font-bold text-red-700 block text-xs\">422 Unproc Entity</span>\n            <span className=\"text-[10px] text-slate-500\">Nota rejeitada pela SEFAZ de destino.</span>\n          </div>\n          <div className=\"bg-white p-2.5 rounded-lg border border-slate-200/50\">\n            <span className=\"font-mono font-bold text-purple-700 block text-xs\">503 Service Down</span>\n            <span className=\"text-[10px] text-slate-500\">Servidores do posto fiscal offline.</span>\n          </div>\n        </div>\n      </div>\n\n      {/* DANFE MODAL PREVIEW ON SCREEN */}\n      {activeDanfeOS && danfeData && (\n        <div className=\"fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 z-50 overflow-y-auto\">\n          <div className=\"bg-white rounded-xl shadow-2xl border border-slate-200 w-full max-w-4xl max-h-[95vh] overflow-y-auto flex flex-col\">\n            \n            {/* Modal header with options */}\n            <div className=\"p-4 bg-slate-900 text-white flex items-center justify-between sticky top-0 z-10\">\n              <div className=\"flex items-center space-x-2\">\n                <FileText className=\"w-5 h-5 text-sky-450\" />\n                <h3 className=\"font-bold\">DANFE - Documento Auxiliar da Nota Fiscal Eletr\303\264nica</h3>\n              </div>\n              <div className=\"flex items-center space-x-2\">\n                <button\n                  onClick={() => window.print()}\n                  className=\"bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-bold px-3.5 py-1.8 rounded-lg text-xs flex items-center space-x-1.5 transition shadow-sm\"\n                >\n                  <Printer className=\"w-3.5 h-3.5\" />\n                  <span>Imprimir NFe</span>\n                </button>\n                <button onClick={() => { setActiveDanfeOS(null); setDanfeData(null); }} className=\"text-slate-450 hover:text-white transition\">\n                  <X className=\"w-5 h-5\" />\n                </button>\n              </div>\n            </div>"
