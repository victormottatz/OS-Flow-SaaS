    replacement_chunks {
      target_content: "export default function Navbar({\n  user,\n  currentTab,\n  setCurrentTab,\n  isOffline,\n  setIsOffline,\n  onLogout,\n  onQuickRoleSwitch\n}: NavbarProps) {\n  return (\n    <header className=\"bg-slate-900 text-white shadow-md border-b border-slate-800\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16\">\n          {/* Brand Logo */}\n          <div className=\"flex items-center space-x-3 cursor-pointer\" onClick={() => setCurrentTab(\"dashboard\")}>\n            <div className=\"bg-teal-500 text-slate-900 p-2 rounded-lg font-bold shadow-md transform hover:rotate-6 transition-all\">\n              <span className=\"text-sm font-mono tracking-wider\">MGV</span>\n            </div>\n            <div>\n              <h1 className=\"text-lg font-bold tracking-tight text-white m-0 font-sans leading-none\">MGV Tecnologia</h1>\n              <p className=\"text-xs text-slate-400 font-mono m-0 mt-0.5 leading-none\">Assist\303\252ncia T\303\251cnica & Faturamento</p>\n            </div>\n          </div>\n\n          {/* Navigation Items */}\n          <nav className=\"hidden md:flex space-x-1 lg:space-x-2\">\n            {[\n              { id: \"dashboard\", label: \"Dashboard\", icon: TrendingUp },\n              { id: \"clients\", label: \"Clientes & Aparelhos\", icon: Users },\n              { id: \"os\", label: \"Nova Ordem de Servi\303\247o\", icon: ClipboardList },\n              { id: \"kanban\", label: \"Quadro T\303\251cnico\", icon: Layers },\n              { id: \"bling\", label: \"Painel Fiscal Bling\", icon: Settings },\n            ].map((tab) => {\n              const Icon = tab.icon;\n              const active = currentTab === tab.id;\n              return (\n                <button\n                  key={tab.id}\n                  id={`nav-tab-${tab.id}`}\n                  onClick={() => setCurrentTab(tab.id)}\n                  className={`flex items-center space-x-2 px-3.5 py-2 rounded-lg text-sm font-medium transition-all duration-200 ${\n                    active\n                      ? \"bg-slate-800 text-teal-400 border-b-2 border-teal-400 shadow-inner\"\n                      : \"text-slate-300 hover:text-white hover:bg-slate-800\"\n                  }`}\n                >\n                  <Icon className={`w-4 h-4 ${active ? \"text-teal-400\" : \"text-slate-400\"}`} />\n                  <span>{tab.label}</span>\n                </button>\n              );\n            })}\n          </nav>\n\n          {/* Controls & Quick Setup */}\n          <div className=\"flex items-center space-x-3\">\n            {/* Offline Simulation Toggle */}\n            <button\n              onClick={() => setIsOffline(!isOffline)}\n              className={`flex items-center space-x-1 px-2.5 py-1.5 rounded-md text-xs font-semibold uppercase tracking-wide transition-all border ${\n                isOffline\n                  ? \"bg-red-950 border-red-500 text-red-200 hover:bg-red-900 anim-pulse\"\n                  : \"bg-slate-800 border-teal-500/30 text-teal-400 hover:bg-slate-700 hover:border-teal-500\"\n              }`}\n              title={isOffline ? \"Clique para reconectar rede f\303\255sica\" : \"Clique para desvincular conex\303\243o (Modo Offline)\"}\n            >\n              {isOffline ? (\n                <>\n                  <WifiOff className=\"w-3.5 h-3.5\" />\n                  <span>Offline</span>\n                </>\n              ) : (\n                <>\n                  <Wifi className=\"w-3.5 h-3.5\" />\n                  <span>Online</span>\n                </>\n              )}\n            </button>\n\n            {/* Quick Switch Role */}\n            <button\n              onClick={onQuickRoleSwitch}\n              className=\"flex items-center space-x-1 px-2.5 py-1.5 text-xs text-slate-300 bg-slate-800 hover:bg-slate-700 hover:text-white rounded-md border border-slate-700\"\n              title=\"Alternar rapidamente entre OWNER e EDITOR para testar bloqueios\"\n            >\n              <RefreshCw className=\"w-3.5 h-3.5\" />\n              <span className=\"hidden sm:inline\">Alternar Perfil</span>\n            </button>\n\n            {/* Identity Badge */}\n            <div className=\"flex flex-col text-right hidden sm:block\">\n              <span className=\"text-xs font-semibold text-slate-100 block\">{user.name}</span>\n              <span\n                className={`text-[10px] uppercase font-mono tracking-wider px-1.5 py-0.5 rounded self-end ${\n                  user.role === UserRole.OWNER\n                    ? \"bg-teal-500/20 text-teal-300 border border-teal-500/30 font-bold\"\n                    : \"bg-amber-500/20 text-amber-300 border border-amber-500/30 font-bold\"\n                }`}\n              >\n                {user.role}\n              </span>\n            </div>\n\n            {/* Logout button */}\n            <button\n              id=\"logout-btn\"\n              onClick={onLogout}\n              className=\"bg-slate-800 p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-700 transition\"\n              title=\"Fazer logout da MGV\"\n            >\n              <LogOut className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>\n      </div>"
      replacement_content: "export default function Navbar({\n  user,\n  currentTab,\n  setCurrentTab,\n  isOffline,\n  setIsOffline,\n  onLogout,\n  onQuickRoleSwitch\n}: NavbarProps) {\n  return (\n    <header className=\"h-16 bg-white border-b border-slate-200 flex items-center justify-between px-4 sm:px-6 shrink-0 shadow-sm select-none\">\n      <div className=\"max-w-7xl w-full mx-auto flex items-center justify-between\">\n        {/* Brand Logo */}\n        <div className=\"flex items-center space-x-3 cursor-pointer\" onClick={() => setCurrentTab(\"dashboard\")}>\n          <div className=\"w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center shadow-sm\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" className=\"h-6 w-6 text-white\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z\" />\n              <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\" />\n            </svg>\n          </div>\n          <div>\n            <h1 className=\"text-sm sm:text-base font-bold text-slate-800 leading-none\">MGV Tecnologia</h1>\n            <p className=\"text-[10px] sm:text-xs text-slate-500 mt-0.5 leading-none font-medium\">Assist\303\252ncia T\303\251cnica & Gest\303\243o</p>\n          </div>\n        </div>\n\n        {/* Navigation Items */}\n        <nav className=\"hidden md:flex items-center space-x-1\">\n          {[\n            { id: \"dashboard\", label: \"Dashboard\", icon: TrendingUp },\n            { id: \"clients\", label: \"Clientes\", icon: Users },\n            { id: \"os\", label: \"Nova OS\", icon: ClipboardList },\n            { id: \"kanban\", label: \"Quadro T\303\251cnico\", icon: Layers },\n            { id: \"bling\", label: \"Painel Fiscal\", icon: Settings },\n          ].map((tab) => {\n            const Icon = tab.icon;\n            const active = currentTab === tab.id;\n            return (\n              <button\n                key={tab.id}\n                id={`nav-tab-${tab.id}`}\n                onClick={() => setCurrentTab(tab.id)}\n                className={`flex items-center space-x-1.5 px-3 py-2 rounded-lg text-xs font-semibold transition-all duration-150 ${\n                  active\n                    ? \"bg-blue-50 text-blue-700 font-bold border border-blue-100\"\n                    : \"text-slate-650 hover:text-slate-900 hover:bg-slate-50 border border-transparent\"\n                }`}\n              >\n                <Icon className={`w-3.5 h-3.5 ${active ? \"text-blue-700\" : \"text-slate-400\"}`} />\n                <span>{tab.label}</span>\n              </button>\n            );\n          })}\n        </nav>\n\n        {/* Controls & Quick Setup */}\n        <div className=\"flex items-center space-x-2 sm:space-x-3\">\n          {/* Offline Simulation Toggle */}\n          <button\n            onClick={() => setIsOffline(!isOffline)}\n            className={`flex items-center gap-1.5 px-2.5 py-1.5 rounded-full border text-[11px] font-bold transition-all ${\n              isOffline\n                ? \"bg-rose-50 border-rose-200 text-rose-700 hover:bg-rose-100 anim-pulse\"\n                : \"bg-emerald-50 border-emerald-100 text-emerald-700 hover:bg-emerald-100/80\"\n            }`}\n            title={isOffline ? \"Clique para reconectar rede f\303\255sica\" : \"Clique para desvincular conex\303\243o (Modo Offline)\"}\n          >\n            <div className={`w-2 h-2 rounded-full ${isOffline ? \"bg-rose-500 anim-pulse\" : \"bg-emerald-500\"}`}></div>\n            <span className=\"hidden xs:inline\">{isOffline ? \"Bling: Offline\" : \"Bling V3: Conectado\"}</span>\n            <span className=\"xs:hidden\">{isOffline ? \"Offline\" : \"Conectado\"}</span>\n          </button>\n\n          {/* Quick Switch Role */}\n          <button\n            onClick={onQuickRoleSwitch}\n            className=\"flex items-center space-x-1 px-2.5 py-1.5 text-xs text-slate-700 bg-slate-150/70 hover:bg-slate-100 rounded-lg border border-slate-200 transition\"\n            title=\"Alternar rapidamente entre OWNER e EDITOR para testar bloqueios\"\n          >\n            <RefreshCw className=\"w-3 h-3 text-slate-500\" />\n            <span className=\"hidden lg:inline font-semibold\">Alternar Perfil</span>\n          </button>\n\n          {/* Identity Badge */}\n          <div className=\"flex flex-col text-right hidden sm:block\">\n            <span className=\"text-xs font-bold text-slate-800 leading-none\">{user.name}</span>\n            <span\n              className={`text-[9px] uppercase font-bold tracking-wider px-1.5 py-0.5 rounded-md mt-0.5 inline-block ${\n                user.role === UserRole.OWNER\n                  ? \"bg-blue-100 text-blue-800 border border-blue-155\"\n                  : \"bg-amber-100 text-amber-800 border border-amber-155\"\n              }`}\n            >\n              {user.role}\n            </span>\n          </div>\n\n          <div className=\"w-8 h-8 bg-slate-100 rounded-full border border-slate-205 flex items-center justify-center font-bold text-xs text-slate-600 hidden sm:flex select-none uppercase\">\n            {user.name.substring(0, 2)}\n          </div>\n\n          {/* Logout button */}\n          <button\n            id=\"logout-btn\"\n            onClick={onLogout}\n            className=\"bg-slate-100 p-2 rounded-lg text-slate-500 hover:text-slate-800 hover:bg-slate-200 transition border border-transparent hover:border-slate-300\"\n            title=\"Fazer logout da MGV\"\n          >\n            <LogOut className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n      </div>\n    </header>\n  );\n}"
    }
