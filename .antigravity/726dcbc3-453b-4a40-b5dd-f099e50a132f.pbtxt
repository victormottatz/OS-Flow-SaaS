  file_change {
    absolute_path_uri: "file:///src/components/DashboardView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useState } from \"react\";\nimport { Client, Device, OrdemServico, Part } from \"../types\";\nimport { \n  Users, Layers, Award, ShieldCheck, Box, BadgePercent, TrendingUp, CheckSquare, \n  Settings, ArrowRight, ClipboardList, PenTool, Database, Plus, ShieldAlert\n} from \"lucide-react\";\n\ninterface DashboardViewProps {\n  clients: Client[];\n  devices: Device[];\n  ordensServico: OrdemServico[];\n  parts: Part[];\n  isOffline: boolean;\n  onRefresh: () => void;\n  setCurrentTab: (tab: string) => void;\n}\n\nexport default function DashboardView({\n  clients,\n  devices,\n  ordensServico,\n  parts,\n  isOffline,\n  onRefresh,\n  setCurrentTab\n}: DashboardViewProps) {\n  // New Part State Form\n  const [partName, setPartName] = useState(\"\");\n  const [partCode, setPartCode] = useState(\"\");\n  const [partStock, setPartStock] = useState(10);\n  const [partCost, setPartCost] = useState(0);\n  const [partPrice, setPartPrice] = useState(0);\n\n  const [loading, setLoading] = useState(false);\n  const [errorMsg, setErrorMsg] = useState(\"\");\n\n  const handleCreatePart = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(\"\");\n\n    if (isOffline) {\n      setErrorMsg(\"O sistema est\303\241 offline. Opera\303\247\303\265es bloqueadas.\");\n      return;\n    }\n\n    if (!partName || !partCode || partStock === undefined || partPrice <= 0) {\n      setErrorMsg(\"Por favor, preencha todos os campos obrigat\303\263rios da pe\303\247a de reposi\303\247\303\243o.\");\n      return;\n    }\n\n    setLoading(true);\n\n    try {\n      const response = await fetch(\"/api/parts\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          name: partName,\n          code: partCode,\n          stock: partStock,\n          cost: partCost,\n          price: partPrice\n        })\n      });\n\n      if (!response.ok) {\n        const d = await response.json();\n        throw new Error(d.error || \"Erro ao salvar pe\303\247a.\");\n      }\n\n      setPartName(\"\");\n      setPartCode(\"\");\n      setPartStock(10);\n      setPartCost(0);\n      setPartPrice(0);\n      onRefresh();\n    } catch (err: any) {\n      setErrorMsg(err.message || \"N\303\243o foi poss\303\255vel inserir pe\303\247a.\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  // Metrics Calculations\n  const totalClientsCount = clients.length;\n  const activeOSCount = ordensServico.filter(o => o.status !== \"FINALIZADO\").length;\n  const totalPartsStock = parts.reduce((sum, p) => sum + p.stock, 0);\n  const totalBilledValue = ordensServico\n    .filter(o => o.status === \"FINALIZADO\" && o.billingStatus === \"FATURADO\")\n    .reduce((sum, o) => sum + o.totalCost, 0);\n\n  return (\n    <div className=\"space-y-8 animate-fadein\">\n      {/* Welcome Banner */}\n      <div className=\"bg-slate-900 text-white rounded-2xl p-6 relative overflow-hidden shadow-lg border border-slate-800\">\n        <div className=\"absolute top-0 right-0 transform translate-x-12 -translate-y-6 opacity-5 pointer-events-none\">\n          <TrendingUp className=\"w-96 h-96 text-white\" />\n        </div>\n        <div className=\"relative z-10 max-w-2xl\">\n          <span className=\"text-[10px] font-bold uppercase tracking-widest font-mono text-teal-400 bg-teal-500/10 border border-teal-500/20 px-2.5 py-1 rounded\">\n            Ambiente de Produ\303\247\303\243o MGV\n          </span>\n          <h2 className=\"text-2xl font-extrabold tracking-tight mt-3 text-white\">Consola de Gest\303\243o de Assist\303\252ncia</h2>\n          <p className=\"text-slate-300 text-sm mt-1\">\n            Gest\303\243o robusta de contratos de servi\303\247os, reposi\303\247\303\243o em bancada de pe\303\247as e emiss\303\243o de notas fiscais integrada de forma transparente com o barramento do Bling.\n          </p>\n        </div>\n      </div>\n\n      {/* Grid metrics row */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5\">\n        {[\n          { label: \"Clientes Ativos\", val: totalClientsCount, desc: \"Fichas no Supabase\", icon: Users, color: \"text-blue-500\" },\n          { label: \"OS na Bancada\", val: activeOSCount, desc: \"Abertas no Kanban\", icon: Layers, color: \"text-amber-500\" },\n          { label: \"Instala\303\247\303\265es de Estoque\", val: `${totalPartsStock} un`, desc: \"Pe\303\247as catalogadas\", icon: Box, color: \"text-purple-500\" },\n          { label: \"Faturado SEFAZ\", val: `R$ ${totalBilledValue.toLocaleString(\'pt-BR\', { minimumFractionDigits: 2 })}`, desc: \"Sucesso no Bling V3\", icon: Award, color: \"text-teal-500\" },\n        ].map((card, idx) => {\n          const Icon = card.icon;\n          return (\n            <div key={idx} className=\"bg-white rounded-xl border border-slate-200/80 p-5 shadow-sm flex items-center justify-between\">\n              <div>\n                <span className=\"text-xs font-semibold text-slate-500 uppercase tracking-wider block\">{card.label}</span>\n                <span className=\"text-2xl font-bold font-mono tracking-tight text-slate-950 mt-1.5 block\">{card.val}</span>\n                <span className=\"text-[11px] text-slate-400 font-mono mt-1 block\">{card.desc}</span>\n              </div>\n              <div className={`p-3.5 bg-slate-50 border border-slate-100/50 rounded-xl ${card.color}`}>\n                <Icon className=\"w-5 h-5\" />\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Main split dashboard section */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        \n        {/* Parts Stock Management */}\n        <div className=\"bg-white rounded-xl border border-slate-200 p-6 shadow-sm lg:col-span-2 space-y-5\">\n          <div className=\"flex items-center justify-between border-b border-slate-100 pb-3\">\n            <div>\n              <h3 className=\"font-bold text-slate-950 text-sm uppercase tracking-wider\">Estoque de Pe\303\247as de Reposi\303\247\303\243o</h3>\n              <p className=\"text-xs text-slate-500\">Controles f\303\255sicos de almoxarifado sob dedu\303\247\303\243o de ordens ativas</p>\n            </div>\n            <span className=\"text-[10px] bg-indigo-50 text-indigo-700 font-mono font-bold px-2.5 py-1 rounded\">\n              Dedu\303\247\303\243o Autom\303\241tica S_3\n            </span>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n            {/* Parts table list */}\n            <div className=\"space-y-2 max-h-[280px] overflow-y-auto\">\n              {parts.length === 0 ? (\n                <p className=\"text-xs text-slate-400 italic font-mono p-4 text-center\">Nenhum insumo f\303\255sico listado.</p>\n              ) : (\n                parts.map(part => (\n                  <div key={part.id} className=\"p-3 bg-slate-50 rounded-lg border border-slate-100/80 text-xs flex justify-between items-center\">\n                    <div>\n                      <p className=\"font-bold text-slate-800\">{part.name}</p>\n                      <p className=\"text-[10px] text-slate-500 font-mono uppercase mt-0.5\">C\303\223D: {part.code} | Custo: R$ {part.cost.toFixed(2)}</p>\n                    </div>\n                    <div className=\"text-right\">\n                      <span className={`px-2 py-0.5 rounded text-[10px] font-bold font-mono ${\n                        part.stock <= 3 ? \"bg-red-100 text-red-800 border border-red-200\" :\n                        part.stock <= 10 ? \"bg-amber-100 text-amber-800\" : \"bg-emerald-100 text-emerald-800\"\n                      }`}>\n                        {part.stock} un\n                      </span>\n                      <p className=\"font-bold text-slate-900 font-mono mt-1\">R$ {part.price.toFixed(2)}</p>\n                    </div>\n                  </div>\n                ))\n              )}\n            </div>\n\n            {/* Quick add Part Form */}\n            <form onSubmit={handleCreatePart} className=\"bg-slate-50 border border-slate-100/80 p-4 rounded-xl space-y-3.5 text-xs\">\n              <h4 className=\"font-bold text-slate-800 text-[11px] uppercase tracking-wider pb-1 border-b border-slate-100 flex items-center space-x-1.5\">\n                <Plus className=\"w-3.5 h-3.5 text-indigo-500\" />\n                <span>Registrar Nova Pe\303\247a</span>\n              </h4>\n\n              {errorMsg && (\n                <div className=\"bg-red-50 text-red-700 p-2 rounded text-[11px]\">\n                  {errorMsg}\n                </div>\n              )}\n\n              <div>\n                <label className=\"block text-slate-600 mb-0.5\">Descri\303\247\303\243o da Pe\303\247a *</label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"Ex: Teclado Mec\303\242nico sem Fio Gamer\"\n                  value={partName}\n                  onChange={(e) => setPartName(e.target.value)}\n                  className=\"w-full bg-white px-2.5 py-1.5 border border-slate-200 rounded text-xs focus:outline-none\"\n                />\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-2\">\n                <div>\n                  <label className=\"block text-slate-600 mb-0.5\">C\303\263d. Almoxarifado *</label>\n                  <input\n                    type=\"text\"\n                    required\n                    placeholder=\"Ex: TEC-MEC-GF\"\n                    value={partCode}\n                    onChange={(e) => setPartCode(e.target.value)}\n                    className=\"w-full bg-white px-2.5 py-1.5 border border-slate-200 rounded text-xs font-mono\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-slate-600 mb-0.5\">Qtd Estoque *</label>\n                  <input\n                    type=\"number\"\n                    min={1}\n                    required\n                    value={partStock}\n                    onChange={(e) => setPartStock(Math.max(1, Number(e.target.value)))}\n                    className=\"w-full bg-white px-2.5 py-1.5 border border-slate-200 rounded text-xs\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-slate-600 mb-0.5\">Pre\303\247o Custo (R$)</label>\n                  <input\n                    type=\"number\"\n                    value={partCost}\n                    onChange={(e) => setPartCost(Math.max(0, Number(e.target.value)))}\n                    className=\"w-full bg-white px-2.5 py-1.5 border border-slate-200 rounded text-xs\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-slate-600 mb-0.5\">Pre\303\247o Venda * (R$)</label>\n                  <input\n                    type=\"number\"\n                    required\n                    value={partPrice}\n                    onChange={(e) => setPartPrice(Math.max(0, Number(e.target.value)))}\n                    className=\"w-full bg-white px-2.5 py-1.5 border border-slate-200 rounded text-xs text-slate-900 font-bold\"\n                  />\n                </div>\n              </div>\n\n              <button\n                type=\"submit\"\n                disabled={loading}\n                className=\"w-full bg-slate-900 text-white font-bold py-2 rounded text-xs hover:bg-slate-800 transition uppercase\"\n              >\n                Cadastrar Pe\303\247a\n              </button>\n            </form>\n          </div>\n        </div>\n\n        {/* Demo Instruction Step Guideline checklist */}\n        <div className=\"bg-slate-50 border border-slate-200 rounded-xl p-6 shadow-sm space-y-4 text-xs text-slate-600\">\n          <h3 className=\"text-xs font-bold text-slate-900 uppercase tracking-wider pb-1.5 border-b border-slate-100 flex items-center space-x-1.5\">\n            <Settings className=\"w-4 h-4 text-teal-600\" />\n            <span>Passo-a-passo para Avalia\303\247\303\243o</span>\n          </h3>\n\n          <div className=\"space-y-3 font-medium\">\n            <div className=\"flex items-start space-x-2\">\n              <span className=\"bg-slate-200 text-slate-800 rounded-full font-bold font-mono text-[10px] w-4.5 h-4.5 flex items-center justify-center shrink-0 mt-0.5\">1</span>\n              <div>\n                <strong className=\"text-slate-800 font-bold block\">Sprint 1: Supabase Auth & Perfis</strong>\n                <p className=\"mt-0.5 text-slate-500\">Alterne entre OWNER e EDITOR na barra de topo. O editor sofrer\303\241 bloqueio se tentar efetuar exclus\303\265es l\303\263gicas.</p>\n              </div>\n            </div>\n\n            <div className=\"flex items-start space-x-2\">\n              <span className=\"bg-slate-200 text-slate-800 rounded-full font-bold font-mono text-[10px] w-4.5 h-4.5 flex items-center justify-center shrink-0 mt-0.5\">2</span>\n              <div>\n                <strong className=\"text-slate-800 font-bold block\">Sprint 2: Clientes & Nova OS</strong>\n                <p className=\"mt-0.5 text-slate-500\">Crie clientes com aparelhos e abra ordens de servi\303\247o. Emita de forma limpa o termo impresso (PDF Termo).</p>\n              </div>\n            </div>\n\n            <div className=\"flex items-start space-x-2\">\n              <span className=\"bg-slate-200 text-slate-800 rounded-full font-bold font-mono text-[10px] w-4.5 h-4.5 flex items-center justify-center shrink-0 mt-0.5\">3</span>\n              <div>\n                <strong className=\"text-slate-800 font-bold block\">Sprint 3: Quadro Kanban & Estoque</strong>\n                <p className=\"mt-0.5 text-slate-500\">Arraste os cart\303\265es de status. Insira pe\303\247as na OS para deduzir o estoque do almoxarifado local.</p>\n              </div>\n            </div>\n\n            <div className=\"flex items-start space-x-2\">\n              <span className=\"bg-slate-200 text-slate-800 rounded-full font-bold font-mono text-[10px] w-4.5 h-4.5 flex items-center justify-center shrink-0 mt-0.5\">4</span>\n              <div>\n                <strong className=\"text-slate-800 font-bold block\">Sprint 4: Nota Danfe & Bling V3</strong>\n                <p className=\"mt-0.5 text-slate-500\">V\303\241 em Painel Fiscal, force falhas de SEFAZ ou Handshake e fature para ver o backoff exponencial em a\303\247\303\243o, com pr\303\251-visualiza\303\247\303\243o de DANFE real.</p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n}\n"
    }
