  file_change {
    absolute_path_uri: "file:///src/components/OSManager.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useState } from \"react\";\nimport { Client, Device, OrdemServico } from \"../types\";\nimport { \n  ClipboardPlus, ArrowRight, UserCheck, Smartphone, CheckSquare, Printer, CheckCircle, ShieldAlert, Award\n} from \"lucide-react\";\n\ninterface OSManagerProps {\n  clients: (Client & { devices: Device[] })[];\n  isOffline: boolean;\n  onRefresh: () => void;\n}\n\nexport default function OSManager({ clients, isOffline, onRefresh }: OSManagerProps) {\n  // Wizard steps\n  const [selectedClientId, setSelectedClientId] = useState(\"\");\n  const [selectedDeviceId, setSelectedDeviceId] = useState(\"\");\n  \n  // OS fields\n  const [reportedDefect, setReportedDefect] = useState(\"\");\n  const [accessoriesLeft, setAccessoriesLeft] = useState(\"\");\n  const [physicalState, setPhysicalState] = useState(\"\");\n\n  // Control\n  const [loading, setLoading] = useState(false);\n  const [errorMsg, setErrorMsg] = useState(\"\");\n  const [createdOS, setCreatedOS] = useState<OrdemServico | null>(null);\n\n  // Selected client & device helpers\n  const selectedClient = clients.find(c => c.id === selectedClientId);\n  const availableDevices = selectedClient?.devices || [];\n  const selectedDevice = availableDevices.find(d => d.id === selectedDeviceId);\n\n  const handleCreateOS = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(\"\");\n\n    if (isOffline) {\n      setErrorMsg(\"Falha ao abrir OS: O sistema est\303\241 offline.\");\n      return;\n    }\n\n    if (!selectedClientId || !selectedDeviceId || !reportedDefect) {\n      setErrorMsg(\"O preenchimento de Cliente, Aparelho e Defeito Relatado \303\251 estritamente obrigat\303\263rio.\");\n      return;\n    }\n\n    setLoading(true);\n\n    try {\n      const response = await fetch(\"/api/ordens-servico\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          clientId: selectedClientId,\n          deviceId: selectedDeviceId,\n          reportedDefect,\n          accessoriesLeft,\n          physicalState\n        })\n      });\n\n      const data = await response.json();\n\n      if (!response.ok) {\n        throw new Error(data.error || \"Erro ao abrir Ordem de Servi\303\247o.\");\n      }\n\n      setCreatedOS(data);\n      onRefresh();\n\n      // Reset form fields\n      setSelectedClientId(\"\");\n      setSelectedDeviceId(\"\");\n      setReportedDefect(\"\");\n      setAccessoriesLeft(\"\");\n      setPhysicalState(\"\");\n\n    } catch (err: any) {\n      setErrorMsg(err.message || \"Erro inesperado.\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  return (\n    <div className=\"space-y-6 max-w-4xl mx-auto\">\n      {/* Printable Area overrides shown inside modal / container */}\n      <style>{`\n        @media print {\n          body * {\n            visibility: hidden;\n          }\n          #printable-termo, #printable-termo * {\n            visibility: visible;\n          }\n          #printable-termo {\n            position: absolute;\n            left: 0;\n            top: 0;\n            width: 100%;\n          }\n        }\n      `}</style>\n\n      <div className=\"border-b border-slate-100 pb-5\">\n        <h2 className=\"text-2xl font-bold text-slate-950 tracking-tight\">Nova Ordem de Servi\303\247o</h2>\n        <p className=\"text-slate-500 text-sm\">Gera\303\247\303\243o sequencial e impress\303\265es de termos de recebimento de ativos na MGV</p>\n      </div>\n\n      {createdOS ? (\n        /* SUCESS & TERM VIEW */\n        <div className=\"space-y-6\">\n          <div className=\"bg-emerald-50 border border-emerald-200 rounded-xl p-5 text-emerald-800 flex items-start space-x-3 shadow-sm\">\n            <CheckCircle className=\"w-5 h-5 mt-0.5 text-emerald-600 shrink-0\" />\n            <div>\n              <h3 className=\"font-bold text-base\">Ordem de Servi\303\247o Aberta com Sucesso!</h3>\n              <p className=\"text-sm mt-1\">\n                Foi gerado o c\303\263digo sequencial exclusivo <strong className=\"font-bold text-slate-900 bg-emerald-200/50 px-2 py-0.5 rounded text-mono font-mono\">{createdOS.osNumber}</strong> para esta entrada de assist\303\252ncia.\n              </p>\n              <div className=\"mt-4 flex flex-wrap gap-2\">\n                <button\n                  onClick={handlePrint}\n                  className=\"bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs px-3.5 py-1.5 rounded-lg flex items-center space-x-1.5 transition\"\n                >\n                  <Printer className=\"w-3.5 h-3.5\" />\n                  <span>Imprimir Termo de Recebimento</span>\n                </button>\n                <button\n                  onClick={() => setCreatedOS(null)}\n                  className=\"bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 font-semibold text-xs px-3.5 py-1.5 rounded-lg transition\"\n                >\n                  Criar Nova OS\n                </button>\n              </div>\n            </div>\n          </div>\n\n          {/* Printable visual client voucher */}\n          <div id=\"printable-termo\" className=\"bg-white border border-slate-300 rounded-xl p-8 shadow-md text-slate-900 max-w-3xl mx-auto print:border-none print:shadow-none font-sans\">\n            <div className=\"flex justify-between items-start border-b border-slate-200 pb-5\">\n              <div>\n                <h1 className=\"text-xl font-bold uppercase tracking-wide\">MGV Tecnologia</h1>\n                <p className=\"text-xs text-slate-500 mt-1 uppercase font-mono\">MGV TECNOLOGIA E ASSIST\303\212NCIA T\303\211CNICA LTDA</p>\n                <p className=\"text-[11px] text-slate-500 font-mono mt-0.5\">CNPJ: 18.291.554/0001-90 | IE: 109.283.412.110</p>\n                <p className=\"text-[11px] text-slate-500 mt-0.5\">Av. Tiradentes, 850 - fone (11) 3218-9900</p>\n              </div>\n              <div className=\"text-right\">\n                <span className=\"text-xs font-bold uppercase text-teal-700 bg-teal-50 border border-teal-200 px-3 py-1 rounded-full font-mono\">\n                  TERMO DE RECEBIMENTO\n                </span>\n                <p className=\"text-2xl font-mono font-bold mt-3 text-slate-950\">{createdOS.osNumber}</p>\n                <p className=\"text-[10px] text-slate-400 font-mono mt-1\">\n                  Abertura: {new Date(createdOS.createdAt).toLocaleString()}\n                </p>\n              </div>\n            </div>\n\n            {/* Client and device metadata table */}\n            <div className=\"my-6 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs\">\n              <div className=\"p-3 bg-slate-50 rounded-lg\">\n                <h4 className=\"font-bold text-slate-800 uppercase text-[10px] tracking-wider mb-2\">Dados do Propriet\303\241rio</h4>\n                <p className=\"font-semibold text-slate-900\">{clients.find(c => c.id === createdOS.clientId)?.name}</p>\n                <p className=\"mt-1\">Documento: {clients.find(c => c.id === createdOS.clientId)?.cpfCnpj}</p>\n                <p>Contato: {clients.find(c => c.id === createdOS.clientId)?.phone}</p>\n                <p className=\"mt-1 text-slate-500\">Endere\303\247o: {clients.find(c => c.id === createdOS.clientId)?.address}</p>\n              </div>\n\n              <div className=\"p-3 bg-slate-50 rounded-lg\">\n                <h4 className=\"font-bold text-slate-800 uppercase text-[10px] tracking-wider mb-2\">equipamento em cust\303\263dia</h4>\n                {(() => {\n                  const client = clients.find(c => c.id === createdOS.clientId);\n                  const dev = client?.devices?.find(d => d.id === createdOS.deviceId);\n                  return (\n                    <>\n                      <p className=\"font-semibold text-slate-900\">{dev?.type} - {dev?.brand}</p>\n                      <p className=\"mt-1\">Modelo: {dev?.model}</p>\n                      <p className=\"font-mono text-[11px]\">N/S: <span className=\"bg-slate-200 px-1 py-0.5 rounded font-bold\">{dev?.serialNumber}</span></p>\n                      <p className=\"mt-1.5 text-slate-500 italic text-[11px]\">Est\303\251tica: {dev?.description}</p>\n                    </>\n                  );\n                })()}\n              </div>\n            </div>\n\n            {/* Defects Checklist details */}\n            <div className=\"space-y-4 text-xs border-t border-slate-100 pt-5\">\n              <div>\n                <h4 className=\"font-bold text-slate-800 uppercase text-[10px] tracking-wider mb-1\">Defeito Relatado pelo Solicitante</h4>\n                <p className=\"p-3 bg-slate-100/50 rounded-lg italic text-slate-700 leading-relaxed font-mono\">\n                  \"{createdOS.reportedDefect}\"\n                </p>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <h4 className=\"font-bold text-slate-800 uppercase text-[10px] tracking-wider mb-1\">Acess\303\263rios Deixados na Oficina</h4>\n                  <p className=\"p-2 bg-slate-50 rounded-lg text-slate-600\">\n                    {createdOS.accessoriesLeft || \"Nenhum acess\303\263rio adicional entregue.\"}\n                  </p>\n                </div>\n                <div>\n                  <h4 className=\"font-bold text-slate-800 uppercase text-[10px] tracking-wider mb-1\">Estado F\303\255sico / Condi\303\247\303\265es do Dispositivo</h4>\n                  <p className=\"p-2 bg-slate-50 rounded-lg text-slate-600\">\n                    {createdOS.physicalState || \"Sem avarias visuais descritas.\"}\n                  </p>\n                </div>\n              </div>\n            </div>\n\n            {/* Firm clauses and agreements for assistance */}\n            <div className=\"mt-8 border-t border-slate-200 pt-5 text-[10px] text-slate-500 leading-relaxed space-y-2\">\n              <p className=\"font-bold text-slate-700\">TERMOS DE GARANTIA, CONDI\303\207\303\225ES E CUST\303\223DIA DA ASSIST\303\212NCIA:</p>\n              <p>\n                1. O propriet\303\241rio autoriza a abertura e desmontagem f\303\255sica do equipamento para diagn\303\263stico pericial. Or\303\247amentos t\303\252m validade legal de 10 dias corridos a partir da data de comunica\303\247\303\243o dos resultados pela equipe.\n              </p>\n              <p>\n                2. Equipamentos prontos n\303\243o retirados em at\303\251 90 dias caracterizam abandono conforme art. 1.275, inciso III, do C\303\263digo Civil, autorizando a MGV Tecnologia a vender ou descart\303\241-los para quita\303\247\303\243o de despesas laboratoriais.\n              </p>\n              <p>\n                3. A MGV Tecnologia n\303\243o se responsabiliza por integridade de softwares corporativos ou perda de informa\303\247\303\265es de armazenamento. O backup de arquivos deve ser efetuado previamente pelo propriet\303\241rio.\n              </p>\n            </div>\n\n            {/* Signature workspace block */}\n            <div className=\"mt-14 grid grid-cols-2 gap-10 text-center text-xs\">\n              <div className=\"border-t border-slate-400 pt-3\">\n                <p className=\"font-semibold text-slate-700\">Representante T\303\251cnico MGV</p>\n                <p className=\"text-[10px] text-slate-400\">Assinatura autorizada</p>\n              </div>\n              <div className=\"border-t border-slate-400 pt-3\">\n                <p className=\"font-semibold text-slate-700\">propriet\303\241rio do ativo</p>\n                <p className=\"text-[10px] text-slate-400\">De acordo com as cl\303\241usulas</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      ) : (\n        /* WIZARD FORM OS */\n        <div className=\"bg-white rounded-2xl shadow-md border border-slate-200 p-6\">\n          <form onSubmit={handleCreateOS} className=\"space-y-6\">\n            {errorMsg && (\n              <div className=\"bg-red-50 border-l-4 border-red-500 p-3 rounded text-xs text-red-700 flex items-start space-x-2\">\n                <ShieldAlert className=\"w-4 h-4 shrink-0 mt-0.5\" />\n                <span>{errorMsg}</span>\n              </div>\n            )}\n\n            {/* STEP 1: CLIENT SELECTION */}\n            <div className=\"space-y-3\">\n              <h3 className=\"text-sm font-bold text-slate-800 uppercase tracking-wider flex items-center space-x-1.5 border-b border-indigo-50 pb-1.5\">\n                <span className=\"bg-slate-900 text-white leading-none rounded-full w-4 h-4 text-[10px] flex items-center justify-center font-mono\">1</span>\n                <span>Vincular Propriet\303\241rio (Cliente)</span>\n              </h3>\n              \n              <div>\n                <label className=\"block text-xs text-slate-500 mb-1 font-semibold\">Selecione o Cliente Cadastrado:</label>\n                <select\n                  required\n                  value={selectedClientId}\n                  onChange={(e) => {\n                    setSelectedClientId(e.target.value);\n                    setSelectedDeviceId(\"\"); // Reset device\n                  }}\n                  className=\"w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-500/10 focus:border-teal-500\"\n                >\n                  <option value=\"\">-- Selecione o Cliente na Base --</option>\n                  {clients.map((c) => (\n                    <option key={c.id} value={c.id}>\n                      {c.name} ({c.cpfCnpj})\n                    </option>\n                  ))}\n                </select>\n                <p className=\"text-[11px] text-slate-500 mt-1\">\n                  Se o cliente for novo, v\303\241 primeiro no menu \"Clientes & Aparelhos\" para registr\303\241-lo.\n                </p>\n              </div>\n            </div>\n\n            {/* STEP 2: DEVICE SELECTION */}\n            {selectedClientId && (\n              <div className=\"space-y-3 anim-slideup\">\n                <h3 className=\"text-sm font-bold text-slate-800 uppercase tracking-wider flex items-center space-x-1.5 border-b border-indigo-50 pb-1.5\">\n                  <span className=\"bg-slate-900 text-white leading-none rounded-full w-4 h-4 text-[10px] flex items-center justify-center font-mono\">2</span>\n                  <span>Escolha o Aparelho Deixado</span>\n                </h3>\n\n                {availableDevices.length === 0 ? (\n                  <div className=\"bg-amber-50 border border-amber-200 p-3 rounded text-xs text-amber-800\">\n                    O cliente selecionado n\303\243o possui aparelhos vinculados ao cadastro. Por favor, adicione um aparelho nas especifica\303\247\303\265es da ficha do cliente antes.\n                  </div>\n                ) : (\n                  <div>\n                    <label className=\"block text-xs text-slate-500 mb-1 font-semibold\">Equipamentos associados:</label>\n                    <select\n                      required\n                      value={selectedDeviceId}\n                      onChange={(e) => setSelectedDeviceId(e.target.value)}\n                      className=\"w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm bg-white text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-500/10\"\n                    >\n                      <option value=\"\">-- Selecione o Dispositivo --</option>\n                      {availableDevices.map((d) => (\n                        <option key={d.id} value={d.id}>\n                          {d.type} {d.brand} {d.model} [S\303\251rie: {d.serialNumber}]\n                        </option>\n                      ))}\n                    </select>\n\n                    {selectedDevice && (\n                      <div className=\"mt-2.5 bg-slate-50 p-3 rounded-lg border border-slate-100 text-xs\">\n                        <p className=\"font-semibold text-slate-800 uppercase text-[9px] tracking-wider mb-1\">Caracter\303\255sticas do aparelho selecionado:</p>\n                        <p className=\"text-slate-600 font-serif italic\">\"{selectedDevice.description}\"</p>\n                      </div>\n                    )}\n                  </div>\n                )}\n              </div>\n            )}\n\n            {/* STEP 3: OS ENTRY PROPERTIES */}\n            {selectedDeviceId && (\n              <div className=\"space-y-4 anim-slideup\">\n                <h3 className=\"text-sm font-bold text-slate-800 uppercase tracking-wider flex items-center space-x-1.5 border-b border-indigo-50 pb-1.5\">\n                  <span className=\"bg-slate-900 text-white leading-none rounded-full w-4 h-4 text-[10px] flex items-center justify-center font-mono\">3</span>\n                  <span>Sintomas e Defeitos Relatados</span>\n                </h3>\n\n                <div className=\"space-y-3.5\">\n                  <div>\n                    <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                      Defeito Relatado pelo Cliente <span className=\"text-red-500\">*</span>\n                    </label>\n                    <textarea\n                      rows={3}\n                      required\n                      placeholder=\"Descreva detalhadamente o sintoma narrado pelo cliente. Ex: Notebook liga mas fica com apitos seguidos e tela completamente preta, superaquecimento repentino.\"\n                      value={reportedDefect}\n                      onChange={(e) => setReportedDefect(e.target.value)}\n                      className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-teal-500\"\n                    />\n                  </div>\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                    <div>\n                      <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Acess\303\263rios Deixados</label>\n                      <input\n                        type=\"text\"\n                        placeholder=\"Ex: Carregador original, cabo USB, capa de prote\303\247\303\243o\"\n                        value={accessoriesLeft}\n                        onChange={(e) => setAccessoriesLeft(e.target.value)}\n                        className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none\"\n                      />\n                    </div>\n\n                    <div>\n                      <label className=\"block text-xs font-semibold text-slate-700 mb-1\">Avarias Est\303\251ticas / Estado no Balc\303\243o</label>\n                      <input\n                        type=\"text\"\n                        placeholder=\"Ex: Tela riscada, aus\303\252ncia de parafuso na carca\303\247a\"\n                        value={physicalState}\n                        onChange={(e) => setPhysicalState(e.target.value)}\n                        className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none\"\n                      />\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"pt-4 border-t border-slate-100 flex justify-end space-x-2\">\n                  <button\n                    type=\"submit\"\n                    disabled={loading}\n                    className=\"bg-slate-900 hover:bg-slate-800 text-white font-semibold text-sm px-5 py-2.5 rounded-lg shadow-md transition flex items-center space-x-2\"\n                  >\n                    <ClipboardPlus className=\"w-4 h-4 text-teal-400\" />\n                    <span>{loading ? \"Registrando Ordem...\" : \"Gerar Ordem e Abrir Termo\"}</span>\n                  </button>\n                </div>\n              </div>\n            )}\n          </form>\n        </div>\n      )}\n    </div>\n  );\n}\n"
