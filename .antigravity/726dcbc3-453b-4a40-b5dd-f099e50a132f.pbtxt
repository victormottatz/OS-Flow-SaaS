    replacement_infos {
      original_chunk {
        target_content: "        {/* Middle column: Sinc Live logs & Circuit Breaker */}\n        <div className=\"bg-slate-900 text-slate-100 rounded-xl p-6 flex flex-col justify-between shadow-md lg:col-span-2\">\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center justify-between border-b border-slate-800 pb-2\">\n              <span className=\"text-xs uppercase font-mono tracking-wider text-teal-400 flex items-center space-x-1.5\">\n                <span className=\"relative flex h-2 w-2\">\n                  <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-450 opacity-75\"></span>\n                  <span className=\"relative inline-flex rounded-full h-2 w-2 bg-teal-500\"></span>\n                </span>\n                <span>Console Monitor Fiscal</span>\n              </span>\n              <span className=\"text-[10px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded font-mono\">\n                Port: HTTPS/V3\n              </span>\n            </div>\n\n            {/* Simulated interactive steps screen */}\n            {isSyncing || syncLogs.length > 0 ? (\n              <div className=\"space-y-3 font-mono text-xs max-h-[300px] overflow-y-auto bg-slate-950 p-4 rounded-lg border border-slate-850\">\n                <p className=\"text-slate-400\">--- IN\303\215CIO DE EXECU\303\207\303\203O ---</p>\n                {syncLogs.map((log, idx) => (\n                  <p key={idx} className={`${\n                    log.includes(\"[SEFAZ REJECT]\") || log.includes(\"[HTTP\") ? \"text-red-400\" :\n                    log.includes(\"[BACKOFF]\") ? \"text-amber-400\" :\n                    log.includes(\"sucesso\") || log.includes(\"autorizou\") ? \"text-emerald-400 font-bold\" :\n                    \"text-slate-300\"\n                  }`}>\n                    {log}\n                  </p>\n                ))}\n                \n                {isSyncing && (\n                  <div className=\"py-2 flex items-center space-x-2 font-semibold text-teal-400 anim-pulse\">\n                    <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n                    <span>{syncStatusMsg}</span>\n                  </div>\n                )}\n              </div>\n            ) : (\n              <div className=\"text-center py-16 text-slate-500 font-mono text-xs\">\n                Selecione uma OS e aperte faturar para iniciar a varredura SEFAZ em tempo real.\n              </div>\n            )}\n\n            {/* Error notifications */}\n            {errorHeader && (\n              <div className=\"bg-red-950 border border-red-800 rounded-lg p-3 text-red-200 text-xs flex items-start space-x-2.5\">\n                <AlertCircle className=\"w-4 h-4 text-red-400 shrink-0 mt-0.5\" />\n                <div>\n                  <strong className=\"font-bold block uppercase\">{errorHeader}</strong>\n                  <p className=\"mt-0.5 text-red-300\">{syncStatusMsg}</p>\n                </div>\n              </div>\n            )}\n          </div>\n\n          <div className=\"pt-4 border-t border-slate-800 text-xs text-slate-400 flex flex-wrap gap-4 mt-6\">\n            <p className=\"flex items-center space-x-1\">\n              <ShieldCheck className=\"w-3.5 h-3.5 text-teal-400\" />\n              <span>Criptografia SSL TLSv1.3 habilitada</span>\n            </p>\n          </div>\n        </div>"
        replacement_content: "        {/* Middle column: Sinc Live logs & Circuit Breaker */}\n        <div className=\"bg-slate-900 text-slate-100 rounded-xl p-6 flex flex-col justify-between shadow-md lg:col-span-2\">\n          <div className=\"space-y-4\">\n            <div className=\"flex items-center justify-between border-b border-slate-800 pb-2\">\n              <span className=\"text-xs uppercase font-mono tracking-wider text-sky-400 flex items-center space-x-1.5\">\n                <span className=\"relative flex h-2 w-2\">\n                  <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-450/70 opacity-75\"></span>\n                  <span className=\"relative inline-flex rounded-full h-2 w-2 bg-sky-400\"></span>\n                </span>\n                <span>Console Monitor Fiscal</span>\n              </span>\n              <span className=\"text-[10px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded font-mono\">\n                Port: HTTPS/V3\n              </span>\n            </div>\n\n            {/* Simulated interactive steps screen */}\n            {isSyncing || syncLogs.length > 0 ? (\n              <div className=\"space-y-3 font-mono text-xs max-h-[300px] overflow-y-auto bg-slate-950 p-4 rounded-lg border border-slate-850\">\n                <p className=\"text-slate-400\">--- IN\303\215CIO DE EXECU\303\207\303\203O ---</p>\n                {syncLogs.map((log, idx) => (\n                  <p key={idx} className={`${\n                    log.includes(\"[SEFAZ REJECT]\") || log.includes(\"[HTTP\") ? \"text-red-400\" :\n                    log.includes(\"[BACKOFF]\") ? \"text-amber-400\" :\n                    log.includes(\"sucesso\") || log.includes(\"autorizou\") ? \"text-emerald-400 font-bold\" :\n                    \"text-slate-300\"\n                  }`}>\n                    {log}\n                  </p>\n                ))}\n                \n                {isSyncing && (\n                  <div className=\"py-2 flex items-center space-x-2 font-semibold text-sky-400 anim-pulse\">\n                    <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n                    <span>{syncStatusMsg}</span>\n                  </div>\n                )}\n              </div>\n            ) : (\n              <div className=\"text-center py-16 text-slate-500 font-mono text-xs\">\n                Selecione uma OS e aperte faturar para iniciar a varredura SEFAZ em tempo real.\n              </div>\n            )}\n\n            {/* Error notifications */}\n            {errorHeader && (\n              <div className=\"bg-red-950 border border-red-800 rounded-lg p-3 text-red-200 text-xs flex items-start space-x-2.5\">\n                <AlertCircle className=\"w-4 h-4 text-red-400 shrink-0 mt-0.5\" />\n                <div>\n                  <strong className=\"font-bold block uppercase\">{errorHeader}</strong>\n                  <p className=\"mt-0.5 text-red-300\">{syncStatusMsg}</p>\n                </div>\n              </div>\n            )}\n          </div>\n\n          <div className=\"pt-4 border-t border-slate-800 text-xs text-slate-400 flex flex-wrap gap-4 mt-6\">\n            <p className=\"flex items-center space-x-1\">\n              <ShieldCheck className=\"w-3.5 h-3.5 text-sky-400\" />\n              <span>Criptografia SSL TLSv1.3 habilitada</span>\n            </p>\n          </div>\n        </div>"
