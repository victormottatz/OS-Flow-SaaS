  file_change {
    absolute_path_uri: "file:///src/components/KanbanBoard.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useState, useEffect } from \"react\";\nimport { OrdemServico, OSStatus, Part, UsedPart, UserRole, Client, Device } from \"../types\";\nimport { \n  ArrowRight, PenTool, ShieldAlert, Award, ChevronRight, Calculator, PackagePlus, \n  Trash2, X, Archive, CheckCircle, Clock, AlertTriangle, Play \n} from \"lucide-react\";\n\ninterface KanbanBoardProps {\n  ordensServico: OrdemServico[];\n  parts: Part[];\n  userRole: UserRole;\n  isOffline: boolean;\n  onRefresh: () => void;\n  onNavigateToBlingPanel: () => void;\n}\n\nconst COLUMNS: { id: OSStatus; name: string; color: string; desc: string }[] = [\n  { id: \"ORCAMENTO\", name: \"Or\303\247amento\", color: \"border-t-blue-500 bg-blue-50/10\", desc: \"Aguardando laudo inicial\" },\n  { id: \"AGUARDANDO_PECA\", name: \"Aguardando Pe\303\247a\", color: \"border-t-amber-500 bg-amber-50/10\", desc: \"Fora de estoque local\" },\n  { id: \"EM_MANUTENCAO\", name: \"Em Manuten\303\247\303\243o\", color: \"border-t-purple-500 bg-purple-50/10\", desc: \"Conserto ativo na bancada\" },\n  { id: \"PRONTO_RETIRADA\", name: \"Pronto p/ Retirada\", color: \"border-t-teal-500 bg-teal-50/10\", desc: \"Reparo efetuado\" },\n  { id: \"FINALIZADO\", name: \"Finalizado\", color: \"border-t-emerald-500 bg-emerald-50/10\", desc: \"Faturando no Bling\" },\n];\n\nexport default function KanbanBoard({ \n  ordensServico, \n  parts, \n  userRole, \n  isOffline, \n  onRefresh,\n  onNavigateToBlingPanel\n}: KanbanBoardProps) {\n  const [selectedOS, setSelectedOS] = useState<OrdemServico | null>(null);\n  const [showEditModal, setShowEditModal] = useState(false);\n  const [draggingId, setDraggingId] = useState<string | null>(null);\n\n  // Form states for OS details edit\n  const [diagnostic, setDiagnostic] = useState(\"\");\n  const [laborCost, setLaborCost] = useState(0);\n  const [selectedParts, setSelectedParts] = useState<UsedPart[]>([]);\n  \n  // Adding part temporarily\n  const [tempPartId, setTempPartId] = useState(\"\");\n  const [tempPartQty, setTempPartQty] = useState(1);\n\n  const [errorMsg, setErrorMsg] = useState(\"\");\n  const [successMsg, setSuccessMsg] = useState(\"\");\n  const [loading, setLoading] = useState(false);\n\n  // Synchronize modal state on opening\n  const openOSDetails = (os: OrdemServico) => {\n    setSelectedOS(os);\n    setDiagnostic(os.diagnostic || \"\");\n    setLaborCost(os.laborCost || 0);\n    setSelectedParts(os.usedParts || []);\n    setErrorMsg(\"\");\n    setSuccessMsg(\"\");\n    setShowEditModal(true);\n  };\n\n  const handleDragStart = (e: React.DragEvent, id: string) => {\n    if (isOffline) {\n      e.preventDefault();\n      alert(\"Opera\303\247\303\265es suspensas: Rede f\303\255sica offline.\");\n      return;\n    }\n    setDraggingId(id);\n  };\n\n  const handleDragOver = (e: React.DragEvent) => {\n    e.preventDefault();\n  };\n\n  const handleDrop = async (e: React.DragEvent, targetStatus: OSStatus) => {\n    e.preventDefault();\n    if (!draggingId || isOffline) return;\n\n    try {\n      const response = await fetch(`/api/ordens-servico/${draggingId}/status`, {\n        method: \"PUT\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({ status: targetStatus })\n      });\n\n      if (!response.ok) {\n        throw new Error(\"Erro ao transferir status\");\n      }\n\n      onRefresh();\n    } catch (err: any) {\n      alert(\"Erro ao alterar status: \" + err.message);\n    } finally {\n      setDraggingId(null);\n    }\n  };\n\n  // Direct click status transition\n  const handleStatusChangeBtn = async (id: string, newStatus: OSStatus) => {\n    if (isOffline) {\n      alert(\"Modo offline: Altera\303\247\303\265es em rede f\303\255sica desabilitadas.\");\n      return;\n    }\n\n    try {\n      const response = await fetch(`/api/ordens-servico/${id}/status`, {\n        method: \"PUT\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({ status: newStatus })\n      });\n\n      if (!response.ok) {\n        throw new Error(\"N\303\243o foi poss\303\255vel processar status.\");\n      }\n\n      onRefresh();\n    } catch (err: any) {\n      alert(err.message);\n    }\n  };\n\n  const handleAddPartToOS = () => {\n    if (!tempPartId) return;\n    const part = parts.find(p => p.id === tempPartId);\n    if (!part) return;\n\n    if (part.stock < tempPartQty) {\n      alert(`Quantidade indispon\303\255vel em estoque f\303\255sico. Estoque atual: ${part.stock}`);\n      return;\n    }\n\n    // Check if already contains\n    const existsIdx = selectedParts.findIndex(item => item.partId === tempPartId);\n    if (existsIdx !== -1) {\n      const updated = [...selectedParts];\n      const newQty = updated[existsIdx].quantity + Number(tempPartQty);\n      if (part.stock < newQty) {\n        alert(`Estoque f\303\255sico ultrapassado! Novo total seria: ${newQty}, Estoque atual: ${part.stock}`);\n        return;\n      }\n      updated[existsIdx].quantity = newQty;\n      setSelectedParts(updated);\n    } else {\n      setSelectedParts([...selectedParts, {\n        partId: part.id,\n        name: part.name,\n        quantity: Number(tempPartQty),\n        price: part.price\n      }]);\n    }\n\n    setTempPartId(\"\");\n    setTempPartQty(1);\n  };\n\n  const handleRemovePartFromOS = (partId: string) => {\n    setSelectedParts(selectedParts.filter(item => item.partId !== partId));\n  };\n\n  // Compute live on-screen cost dynamically\n  const partsTotal = selectedParts.reduce((sum, item) => sum + (item.price * item.quantity), 0);\n  const computedTotal = partsTotal + Number(laborCost);\n\n  const handleSaveOSDetails = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(\"\");\n    setSuccessMsg(\"\");\n\n    if (isOffline) {\n      setErrorMsg(\"Falha na grava\303\247\303\243o: O sistema est\303\241 offline.\");\n      return;\n    }\n\n    if (!selectedOS) return;\n\n    setLoading(true);\n\n    try {\n      const response = await fetch(`/api/ordens-servico/${selectedOS.id}`, {\n        method: \"PUT\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          diagnostic,\n          usedParts: selectedParts,\n          laborCost\n        })\n      });\n\n      const data = await response.json();\n\n      if (!response.ok) {\n        throw new Error(data.error || \"Erro ao gravar informa\303\247\303\265es t\303\251cnicas.\");\n      }\n\n      setSuccessMsg(\"Laudo pericial e pe\303\247as salvas de forma \303\255ntegra!\");\n      onRefresh();\n\n      setTimeout(() => {\n        setShowEditModal(false);\n        setSuccessMsg(\"\");\n      }, 1200);\n\n    } catch (err: any) {\n      setErrorMsg(err.message || \"Erro inesperado.\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleDeleteOS = async () => {\n    if (!selectedOS) return;\n\n    if (isOffline) {\n      alert(\"Opera\303\247\303\243o bloqueada: Oficina offline.\");\n      return;\n    }\n\n    if (userRole !== UserRole.OWNER) {\n      alert(\"Acesso Negado: T\303\251cnicos de n\303\255vel EDITOR n\303\243o possuem privil\303\251gios para excluir Ordens de Servi\303\247o.\");\n      return;\n    }\n\n    if (!confirm(\"Tem certeza que deseja aplicar exclus\303\243o l\303\263gica (Soft Delete) no registro desta OS?\")) {\n      return;\n    }\n\n    try {\n      const response = await fetch(`/api/ordens-servico/${selectedOS.id}`, {\n        method: \"DELETE\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          \"x-user-role\": userRole\n        }\n      });\n\n      if (!response.ok) {\n        throw new Error(\"Erro ao excluir.\");\n      }\n\n      alert(\"Ordem de servi\303\247o arquivada logicamente.\");\n      setShowEditModal(false);\n      onRefresh();\n    } catch (err: any) {\n      alert(err.message);\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Offline Alert Banner */}\n      {isOffline && (\n        <div className=\"bg-red-950 border border-red-500 rounded-lg p-3 text-red-200 text-xs flex items-center space-x-2 animate-pulse shadow-inner\">\n          <AlertTriangle className=\"w-4 h-4 text-red-400 shrink-0\" />\n          <span>\n            <strong>ALERTA DE SEGURAN\303\207A FIS\303\215CO:</strong> Conex\303\243o offline ativa. Movimenta\303\247\303\243o f\303\255sica de cart\303\265es Kanban e sincronia autom\303\241tica com a SEFAZ bloqueados.\n          </span>\n        </div>\n      )}\n\n      <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-100 pb-5\">\n        <div>\n          <h2 className=\"text-2xl font-bold text-slate-950 tracking-tight\">Quadro T\303\251cnico / Kanban</h2>\n          <p className=\"text-slate-500 text-sm\">Controle de andamento mec\303\242nico, diagn\303\263stico de pe\303\247as e faturamento finalizador</p>\n        </div>\n      </div>\n\n      {/* Grid columns */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-5 gap-4\">\n        {COLUMNS.map((column) => {\n          // Filter OS matching status\n          const colOS = ordensServico.filter(os => os.status === column.id);\n\n          return (\n            <div\n              key={column.id}\n              onDragOver={handleDragOver}\n              onDrop={(e) => handleDrop(e, column.id)}\n              className={`rounded-xl border border-slate-200/80 border-t-4 p-4 flex flex-col min-h-[500px] gap-3 shadow-sm ${column.color}`}\n            >\n              {/* Col Info Header */}\n              <div className=\"flex items-center justify-between border-b border-slate-100 pb-2\">\n                <div>\n                  <h3 className=\"font-bold text-sm text-slate-900 leading-none\">{column.name}</h3>\n                  <p className=\"text-[10px] text-slate-400 mt-1 leading-none\">{column.desc}</p>\n                </div>\n                <span className=\"bg-slate-900 text-white font-mono text-[11px] font-bold px-2 py-0.5 rounded-full\">\n                  {colOS.length}\n                </span>\n              </div>\n\n              {/* Work Order Cards */}\n              <div className=\"flex-1 space-y-3 overflow-y-auto\">\n                {colOS.length === 0 ? (\n                  <div className=\"border border-dashed border-slate-200 rounded-lg p-6 text-center text-[11px] text-slate-400\">\n                    Nenhum cart\303\243o nesta coluna\n                  </div>\n                ) : (\n                  colOS.map((os) => {\n                    const partsTotal = os.usedParts?.reduce((sum, item) => sum + (item.price * item.quantity), 0) || 0;\n                    const computedTotal = partsTotal + (os.laborCost || 0);\n\n                    return (\n                      <div\n                        key={os.id}\n                        draggable\n                        onDragStart={(e) => handleDragStart(e, os.id)}\n                        onClick={() => openOSDetails(os)}\n                        className={`bg-white rounded-lg border border-slate-200 p-3 shadow-sm hover:shadow-md hover:border-teal-400 cursor-pointer transition relative group ${\n                          isOffline ? \"opacity-75 cursor-not-allowed\" : \"\"\n                        }`}\n                      >\n                        {/* Quick Status Tag badge inside */}\n                        <div className=\"flex items-center justify-between mb-2\">\n                          <span className=\"text-[11px] font-bold font-mono text-slate-900 bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200\">\n                            {os.osNumber}\n                          </span>\n                          \n                          {/* Fiscal Status tag */}\n                          {os.status === \"FINALIZADO\" && (\n                            <span className={`text-[9px] font-extrabold uppercase px-1 rounded truncate max-w-[80px] ${\n                              os.billingStatus === \"FATURADO\" ? \"bg-emerald-100 text-emerald-800\" :\n                              os.billingStatus === \"REJEITADO\" ? \"bg-red-100 text-red-800\" :\n                              os.billingStatus === \"TIMEOUT\" ? \"bg-amber-100 text-amber-800\" :\n                              \"bg-slate-100 text-slate-600 anim-pulse\"\n                            }`} title={`Faturamento: ${os.billingStatus}`}>\n                              {os.billingStatus}\n                            </span>\n                          )}\n                        </div>\n\n                        <h4 className=\"font-bold text-slate-900 text-xs truncate max-w-[160px]\">\n                          {(os as any).client?.name || \"Cliente Desconhecido\"}\n                        </h4>\n                        \n                        <p className=\"text-[11px] text-slate-500 mt-0.5\">\n                          {(os as any).device?.type} {(os as any).device?.brand} ({(os as any).device?.model})\n                        </p>\n\n                        <div className=\"border-t border-slate-100 mt-2.5 pt-2 flex items-center justify-between text-[11px]\">\n                          <span className=\"text-slate-400 font-mono\">\n                            {new Date(os.createdAt).toLocaleDateString()}\n                          </span>\n                          <span className=\"text-slate-900 font-semibold font-mono\">\n                            R$ {computedTotal.toLocaleString(\'pt-BR\', { minimumFractionDigits: 2 })}\n                          </span>\n                        </div>\n\n                        {/* Quick interactive transitions buttons beneath to bypass drag constraints if needed */}\n                        <div className=\"hidden group-hover:flex items-center justify-end space-x-1 border-t border-slate-100/60 mt-2 pt-1.5 z-10\">\n                          {column.id !== \"FINALIZADO\" && (\n                            <button\n                              onClick={(e) => {\n                                e.stopPropagation();\n                                const index = COLUMNS.findIndex(v => v.id === column.id);\n                                if (index !== -1 && index + 1 < COLUMNS.length) {\n                                  handleStatusChangeBtn(os.id, COLUMNS[index+1].id);\n                                }\n                              }}\n                              className=\"text-[11px] text-teal-600 hover:text-teal-700 font-bold px-1.5 py-0.5 rounded hover:bg-teal-50 flex items-center space-x-0.5\"\n                              title=\"Avan\303\247ar status\"\n                            >\n                              <span>Avan\303\247ar</span>\n                              <ChevronRight className=\"w-3 h-3\" />\n                            </button>\n                          )}\n                        </div>\n                      </div>\n                    );\n                  })\n                )}\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* MODAL: OS DETAIL REPORTING WORKSPACE */}\n      {showEditModal && selectedOS && (\n        <div className=\"fixed inset-0 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center p-4 z-50 overflow-y-auto\">\n          <div className=\"bg-white rounded-xl shadow-2xl border border-slate-150 w-full max-w-2xl max-h-[90vh] overflow-y-auto flex flex-col\">\n            \n            {/* Header */}\n            <div className=\"px-6 py-4 bg-slate-900 text-white flex items-center justify-between rounded-t-xl sticky top-0 z-15\">\n              <div className=\"flex items-center space-x-2\">\n                <PenTool className=\"w-5 h-5 text-teal-400\" />\n                <h3 className=\"font-bold text-lg\">Prancheta do T\303\251cnico - {selectedOS.osNumber}</h3>\n              </div>\n              <button onClick={() => setShowEditModal(false)} className=\"text-slate-400 hover:text-white transition\">\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            {/* Inner Content */}\n            <form onSubmit={handleSaveOSDetails} className=\"p-6 space-y-5 flex-1 overflow-y-auto\">\n              {errorMsg && (\n                <div className=\"bg-red-50 border-l-4 border-red-500 p-3 rounded text-xs text-red-700\">\n                  {errorMsg}\n                </div>\n              )}\n\n              {successMsg && (\n                <div className=\"bg-green-50 border-l-4 border-green-500 p-3 rounded text-xs text-green-700\">\n                  {successMsg}\n                </div>\n              )}\n\n              {/* Status information banner */}\n              <div className=\"bg-slate-50 p-3 rounded-lg flex flex-wrap gap-4 text-xs select-none\">\n                <p><span className=\"font-bold text-slate-500 uppercase tracking-wider text-[10px]\">Cliente:</span> <strong className=\"text-slate-800\">{(selectedOS as any).client?.name}</strong></p>\n                <p><span className=\"font-bold text-slate-500 uppercase tracking-wider text-[10px]\">Aparelho:</span> <strong className=\"text-slate-800\">{(selectedOS as any).device?.type} {(selectedOS as any).device?.brand} ({(selectedOS as any).device?.model})</strong></p>\n                <p><span className=\"font-bold text-slate-500 uppercase tracking-wider text-[10px]\">Defeito original:</span> <span className=\"text-slate-600 font-mono\">\"{(selectedOS as any).reportedDefect}\"</span></p>\n              </div>\n\n              {/* 1. Diagn\303\263stico T\303\251cnico */}\n              <div>\n                <label className=\"block text-xs font-bold uppercase text-slate-700 mb-1\">Diagn\303\263stico Pericial T\303\251cnico</label>\n                <textarea\n                  rows={3}\n                  required\n                  placeholder=\"Escreva quais testes foram executados, qual a anomalia detectada fisicamente na placa ou sistema, e as a\303\247\303\265es de reparo recomendadas.\"\n                  value={diagnostic}\n                  onChange={(e) => setDiagnostic(e.target.value)}\n                  className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-purple-500\"\n                />\n              </div>\n\n              {/* 2. Parts placement layout */}\n              <div className=\"border border-slate-100 rounded-xl p-4 bg-slate-50/50 space-y-4\">\n                <h4 className=\"text-xs font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-1 flex items-center space-x-1.5\">\n                  <PackagePlus className=\"w-4 h-4 text-purple-500\" />\n                  <span>Substitui\303\247\303\243o de Pe\303\247as & Pe\303\247as Utilizadas</span>\n                </h4>\n\n                <div className=\"flex flex-col sm:flex-row items-end gap-3 bg-white p-3 rounded-lg border border-slate-100\">\n                  <div className=\"flex-1\">\n                    <label className=\"block text-[11px] font-semibold text-slate-600 mb-1\">Pesquisar Pe\303\247a em Estoque:</label>\n                    <select\n                      value={tempPartId}\n                      onChange={(e) => setTempPartId(e.target.value)}\n                      className=\"w-full px-2.5 py-1.5 border border-slate-200 rounded text-xs text-slate-800 bg-white\"\n                    >\n                      <option value=\"\">-- Selecione a Pe\303\247a no Almoxarifado --</option>\n                      {parts.map(p => (\n                        <option key={p.id} value={p.id}>\n                          {p.name} (Espelho: {p.code}) [Qtd: {p.stock} | Pre\303\247o: R$ {p.price.toFixed(2)}]\n                        </option>\n                      ))}\n                    </select>\n                  </div>\n\n                  <div className=\"w-24\">\n                    <label className=\"block text-[11px] font-semibold text-slate-600 mb-1\">Qtd:</label>\n                    <input\n                      type=\"number\"\n                      min={1}\n                      value={tempPartQty}\n                      onChange={(e) => setTempPartQty(Math.max(1, Number(e.target.value)))}\n                      className=\"w-full px-2 py-1 border border-slate-200 rounded text-xs text-slate-800\"\n                    />\n                  </div>\n\n                  <button\n                    type=\"button\"\n                    onClick={handleAddPartToOS}\n                    className=\"bg-slate-900 text-white font-bold text-xs px-3.5 py-1.8 h-[34px] rounded hover:bg-slate-800 transition uppercase shrink-0\"\n                  >\n                    Lan\303\247ar Pe\303\247a\n                  </button>\n                </div>\n\n                {/* Used pieces summary list */}\n                {selectedParts.length === 0 ? (\n                  <p className=\"text-xs text-slate-400 italic font-mono\">Nenhuma pe\303\247a cadastrada para reposi\303\247\303\243o nesta OS.</p>\n                ) : (\n                  <div className=\"space-y-2\">\n                    {selectedParts.map((p, idx) => (\n                      <div key={p.partId} className=\"flex items-center justify-between text-xs bg-white p-2.5 rounded border border-slate-100\">\n                        <div>\n                          <span className=\"font-semibold text-slate-800\">{p.name}</span>\n                          <span className=\"text-slate-400 mx-1.5\">|</span>\n                          <span className=\"text-slate-500 font-mono\">{p.quantity} x R$ {p.price.toFixed(2)}</span>\n                        </div>\n                        <div className=\"flex items-center space-x-3\">\n                          <span className=\"font-bold text-slate-900 font-mono\">\n                            R$ {(p.price * p.quantity).toLocaleString(\'pt-BR\', { minimumFractionDigits: 2 })}\n                          </span>\n                          <button\n                            type=\"button\"\n                            onClick={() => handleRemovePartFromOS(p.partId)}\n                            className=\"text-red-500 hover:text-red-700\"\n                            title=\"Remover pe\303\247a da OS\"\n                          >\n                            <Trash2 className=\"w-4 h-4\" />\n                          </button>\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                )}\n              </div>\n\n              {/* 3. Labor cost & Dynamic calculation summation */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <label className=\"block text-xs font-bold uppercase text-slate-700 mb-1\">M\303\243o de Obra de Reparo (R$)</label>\n                  <input\n                    type=\"number\"\n                    min={0}\n                    value={laborCost}\n                    onChange={(e) => setLaborCost(Math.max(0, Number(e.target.value)))}\n                    className=\"w-full px-3 py-2 border border-slate-200 rounded-lg text-sm text-slate-800 font-mono font-bold focus:outline-none focus:border-teal-500\"\n                  />\n                  <p className=\"text-[10px] text-slate-400 mt-1\">Insira o valor em reais correspondente ao servi\303\247o t\303\251cnico.</p>\n                </div>\n\n                <div className=\"bg-slate-900 text-white rounded-lg p-3 flex flex-col justify-center items-end text-right\">\n                  <span className=\"text-[10px] font-mono uppercase tracking-wider text-slate-400\">Total do Conserto</span>\n                  <p className=\"text-2xl font-mono font-bold text-teal-400\">\n                    R$ {computedTotal.toLocaleString(\'pt-BR\', { minimumFractionDigits: 2 })}\n                  </p>\n                  <span className=\"text-[10px] text-slate-500\">M\303\243o de Obra + Pe\303\247as</span>\n                </div>\n              </div>\n\n              {/* Bling Transition reminder */}\n              {selectedOS.status === \"PRONTO_RETIRADA\" && (\n                <div className=\"bg-teal-900/10 border border-teal-500/30 rounded-lg p-3 text-xs text-teal-300 flex items-start space-x-2\">\n                  <Clock className=\"w-4 h-4 text-teal-400 shrink-0 mt-0.5\" />\n                  <span>\n                    <strong>INFORMA\303\207\303\203O FISCAL:</strong> Mudar o status dessa OS para <strong>\"Finalizado\"</strong> na tela de Kanban integrar\303\241 os dados automaticamente com a API V3 da Bling para emiss\303\243o s\303\255ncrona da nota DANFE em sua tela corporativa.\n                  </span>\n                </div>\n              )}\n\n              {selectedOS.status === \"FINALIZADO\" && selectedOS.billingStatus === \"FATURADO\" && (\n                <div className=\"bg-emerald-900/10 border border-emerald-500/30 rounded-lg p-3 text-xs text-emerald-300 flex items-center justify-between\">\n                  <span className=\"flex items-center space-x-1.5\">\n                    <CheckCircle className=\"w-4 h-4 text-emerald-400\" />\n                    <span>Faturamento oficial autorizado pela SEFAZ neste ativo.</span>\n                  </span>\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      setShowEditModal(false);\n                      onNavigateToBlingPanel();\n                    }}\n                    className=\"bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold px-2 py-1 rounded text-[10px] uppercase font-mono\"\n                  >\n                    Visualizar DANFE\n                  </button>\n                </div>\n              )}\n\n              {/* Actions Footer */}\n              <div className=\"flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-slate-100 pt-4\">\n                {/* Logical deletion block with Owner Check */}\n                <button\n                  type=\"button\"\n                  onClick={handleDeleteOS}\n                  className={`flex items-center space-x-1.5 px-3 py-2 rounded-lg text-xs font-semibold ${\n                    userRole === UserRole.OWNER\n                      ? \"text-red-700 bg-red-50 hover:bg-red-100 border border-red-200\"\n                      : \"text-slate-400 bg-slate-100 border border-slate-200 cursor-not-allowed\"\n                  }`}\n                  disabled={userRole !== UserRole.OWNER}\n                  title={userRole !== UserRole.OWNER ? \"Somente OWNER pode arquivar uma OS\" : \"Mudar coluna deletedAt no Supabase (Soft Delete)\"}\n                >\n                  <Trash2 className=\"w-3.5 h-3.5\" />\n                  <span>Excluir OS (Soft Delete)</span>\n                </button>\n\n                <div className=\"flex space-x-2 w-full sm:w-auto justify-end\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setShowEditModal(false)}\n                    className=\"px-4 py-2 border border-slate-200 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-50 flex-1 sm:flex-none\"\n                  >\n                    Fechar\n                  </button>\n                  <button\n                    type=\"submit\"\n                    disabled={loading}\n                    className=\"px-5 py-2 bg-slate-900 hover:bg-slate-800 text-white font-semibold text-sm rounded-lg flex-1 sm:flex-none\"\n                  >\n                    {loading ? \"Salvando...\" : \"Salvar Grava\303\247\303\265es\"}\n                  </button>\n                </div>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n\n    </div>\n  );\n}\n"
    }
    diff {
      unified_diff {
