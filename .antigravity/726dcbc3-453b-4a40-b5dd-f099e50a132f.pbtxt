      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport { useState } from \"react\";\nimport { User, UserRole } from \"../types\";\nimport { LogIn, UserPlus, Info, CheckCircle, ShieldAlert } from \"lucide-react\";\n\ninterface LoginFormProps {\n  onLoginSuccess: (user: User, token: string) => void;\n  isOffline: boolean;\n}\n\nexport default function LoginForm({ onLoginSuccess, isOffline }: LoginFormProps) {\n  const [isLoginMode, setIsLoginMode] = useState(true);\n  const [name, setName] = useState(\"\");\n  const [email, setEmail] = useState(\"\");\n  const [password, setPassword] = useState(\"\");\n  const [role, setRole] = useState<UserRole>(UserRole.EDITOR);\n  \n  // Feedbacks\n  const [errorMsg, setErrorMsg] = useState(\"\");\n  const [successMsg, setSuccessMsg] = useState(\"\");\n  const [loading, setLoading] = useState(false);\n\n  // Simple password strength verification\n  const validatePassword = (pwd: string) => {\n    if (pwd.length < 6) {\n      return \"A senha deve conter no m\303\255nimo 6 caracteres.\";\n    }\n    return null;\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(\"\");\n    setSuccessMsg(\"\");\n\n    if (isOffline) {\n      setErrorMsg(\"O sistema est\303\241 offline. N\303\243o \303\251 poss\303\255vel processar requisi\303\247\303\265es Supabase Auth sem internet.\");\n      return;\n    }\n\n    if (!email || !password || (!isLoginMode && !name)) {\n      setErrorMsg(\"Por favor, preencha todos os campos obrigat\303\263rios.\");\n      return;\n    }\n\n    const pwdErr = validatePassword(password);\n    if (!isLoginMode && pwdErr) {\n      setErrorMsg(pwdErr);\n      return;\n    }\n\n    setLoading(true);\n\n    try {\n      const endpoint = isLoginMode ? \"/api/auth/login\" : \"/api/auth/register\";\n      const body = isLoginMode ? { email, password } : { name, email, password, role };\n\n      const response = await fetch(endpoint, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(body)\n      });\n\n      const data = await response.json();\n\n      if (!response.ok) {\n        throw new Error(data.error || \"Erro ao processar solicita\303\247\303\243o.\");\n      }\n\n      if (isLoginMode) {\n        onLoginSuccess(data.user, data.token);\n      } else {\n        setSuccessMsg(\"Colaborador registrado com sucesso na infraestrutura Supabase!\");\n        // Clear registration fields and switch to login\n        setName(\"\");\n        setEmail(\"\");\n        setPassword(\"\");\n        setRole(UserRole.EDITOR);\n        setTimeout(() => {\n          setIsLoginMode(true);\n          setSuccessMsg(\"\");\n        }, 2200);\n      }\n    } catch (err: any) {\n      setErrorMsg(err.message || \"Falha ao conectar com o servidor.\");\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"min-h-[80vh] flex items-center justify-center px-4 bg-slate-50\">\n      <div className=\"w-full max-w-md bg-white rounded-2xl shadow-xl border border-slate-100 overflow-hidden\">\n        {/* Banner Area */}\n        <div className=\"bg-slate-900 px-6 py-8 text-white relative text-center\">\n          <div className=\"absolute top-2 right-2 flex items-center bg-teal-500/10 text-teal-400 border border-teal-500/30 font-mono text-[9px] uppercase tracking-wider px-2 py-0.5 rounded\">\n            Supabase Auth Ativo\n          </div>\n          <div className=\"w-12 h-12 bg-teal-500 rounded-xl mx-auto flex items-center justify-center font-bold text-slate-900 mb-3 shadow-lg\">\n            MGV\n          </div>\n          <h2 className=\"text-xl font-bold tracking-tight\">MGV Assist\303\252ncia T\303\251cnica</h2>\n          <p className=\"text-xs text-slate-400 mt-1 max-w-xs mx-auto\">\n            Substituto Corporativo Web Integrado do SH Oficina Desktop\n          </p>\n        </div>\n\n        {/* Auth Mode Tabs */}\n        <div className=\"flex border-b border-slate-100\">\n          <button\n            onClick={() => {\n              setIsLoginMode(true);\n              setErrorMsg(\"\");\n              setSuccessMsg(\"\");\n            }}\n            className={`w-1/2 py-3 text-sm font-semibold transition ${\n              isLoginMode\n                ? \"text-teal-600 bg-teal-50/20 border-b-2 border-teal-500\"\n                : \"text-slate-500 hover:text-slate-900\"\n            }`}\n          >\n            Acessar Sistema\n          </button>\n          <button\n            onClick={() => {\n              setIsLoginMode(false);\n              setErrorMsg(\"\");\n              setSuccessMsg(\"\");\n            }}\n            className={`w-1/2 py-3 text-sm font-semibold transition ${\n              !isLoginMode\n                ? \"text-teal-600 bg-teal-50/20 border-b-2 border-teal-500\"\n                : \"text-slate-500 hover:text-slate-900\"\n            }`}\n          >\n            Cadastrar T\303\251cnico\n          </button>\n        </div>\n\n        <div className=\"p-6\">\n          {errorMsg && (\n            <div className=\"mb-4 bg-red-50 border-l-4 border-red-500 p-3 rounded text-sm text-red-700 flex items-start space-x-2\">\n              <ShieldAlert className=\"w-4 h-4 mt-0.5 shrink-0\" />\n              <span>{errorMsg}</span>\n            </div>\n          )}\n\n          {successMsg && (\n            <div className=\"mb-4 bg-green-50 border-l-4 border-green-500 p-3 rounded text-sm text-green-700 flex items-start space-x-2\">\n              <CheckCircle className=\"w-4 h-4 mt-0.5 shrink-0\" />\n              <span>{successMsg}</span>\n            </div>\n          )}\n\n          <form onSubmit={handleSubmit} className=\"space-y-4\">\n            {!isLoginMode && (\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1\">\n                  Nome Completo\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"Ex: Vin\303\255cius Souza\"\n                  value={name}\n                  onChange={(e) => setName(e.target.value)}\n                  className=\"w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 transition\"\n                />\n              </div>\n            )}\n\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1\">\n                E-mail de Trabalho\n              </label>\n              <input\n                type=\"email\"\n                required\n                placeholder=\"Ex: tecnico@mgv.com\"\n                value={email}\n                onChange={(e) => setEmail(e.target.value)}\n                className=\"w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 transition\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1\">\n                Senha Segura\n              </label>\n              <input\n                type=\"password\"\n                required\n                placeholder=\"\342\200\242 \342\200\242 \342\200\242 \342\200\242 \342\200\242 \342\200\242\"\n                value={password}\n                onChange={(e) => setPassword(e.target.value)}\n                className=\"w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 transition\"\n              />\n            </div>\n\n            {!isLoginMode && (\n              <div>\n                <label className=\"block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1\">\n                  Perfil de Acesso (Role)\n                </label>\n                <select\n                  value={role}\n                  onChange={(e) => setRole(e.target.value as UserRole)}\n                  className=\"w-full px-3 py-2.5 border border-slate-200 rounded-lg text-sm focus:outline-none bg-white focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 transition\"\n                >\n                  <option value={UserRole.EDITOR}>EDITOR (T\303\251cnicos e Atendentes)</option>\n                  <option value={UserRole.OWNER}>OWNER (Diretores e Administradores)</option>\n                </select>\n                <p className=\"text-[11px] text-slate-500 mt-1 flex items-start space-x-1\">\n                  <Info className=\"w-3.5 h-3.5 shrink-0 mt-0.5 text-teal-500\" />\n                  <span>\n                    O perfil EDITOR n\303\243o pode excluir Clientes ou Ordens de Servi\303\247o (Seguran\303\247a e RLS).\n                  </span>\n                </p>\n              </div>\n            )}\n\n            <button\n              type=\"submit\"\n              disabled={loading}\n              className=\"w-full mt-2 bg-slate-900 text-white py-2.5 rounded-lg text-sm font-semibold hover:bg-slate-800 transition shadow-md flex items-center justify-center space-x-2 disabled:bg-slate-400 disabled:cursor-not-allowed\"\n            >\n              {loading ? (\n                <span>Tratando com o Supabase Auth...</span>\n              ) : isLoginMode ? (\n                <>\n                  <LogIn className=\"w-4 h-4\" />\n                  <span>Acessar Oficina</span>\n                </>\n              ) : (\n                <>\n                  <UserPlus className=\"w-4 h-4\" />\n                  <span>Cadastrar no Banco</span>\n                </>\n              )}\n            </button>\n          </form>\n\n          {/* Seed credentials assistance panel */}\n          {isLoginMode && (\n            <div className=\"mt-6 border-t border-slate-100 pt-4 text-xs\">\n              <h4 className=\"font-semibold text-slate-700 mb-2\">Contas de Teste (Seeding Ativo):</h4>\n              <div className=\"grid grid-cols-2 gap-2 text-slate-600 font-mono\">\n                <div className=\"p-2 bg-teal-50 rounded border border-teal-100/50\">\n                  <p className=\"font-bold text-teal-800 text-[10px] uppercase\">Dono (OWNER)</p>\n                  <p className=\"mt-0.5\">gerente@mgv.com</p>\n                  <p className=\"text-[10px] text-slate-400\">Senha: mgv123</p>\n                </div>\n                <div className=\"p-2 bg-amber-50 rounded border border-amber-100/50\">\n                  <p className=\"font-bold text-amber-800 text-[10px] uppercase\">T\303\251cnico (EDITOR)</p>\n                  <p className=\"mt-0.5\">tecnico@mgv.com</p>\n                  <p className=\"text-[10px] text-slate-400\">Senha: tecnico123</p>\n                </div>\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    }
