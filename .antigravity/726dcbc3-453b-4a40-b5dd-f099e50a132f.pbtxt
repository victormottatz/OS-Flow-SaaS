          text: "            secondsLeft--;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            setSyncStatusMsg(`Retentando em ${secondsLeft}s... (Tentativa ${attempt}/3)`);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            if (secondsLeft <= 0) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              clearInterval(timerInterval);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              setSyncLogs(prev => [...prev, `[RETENTATIVA ${attempt}] Despachando nota fiscal ao Bling...`]);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              attempt++;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              runRetry();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
