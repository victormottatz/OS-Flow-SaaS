generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(EDITOR)
  createdAt    DateTime @default(now())
  permissions  String[] @default([])
  avatarUrl    String?
  bio          String?
  phone        String?
  tags         Tag[]

  @@map("users")
}

model Client {
  id           String         @id @default(uuid())
  name         String
  cpfCnpj      String
  phone        String
  email        String
  address      String
  deletedAt    DateTime?
  legacyId     String?        @unique
  birthday     DateTime?
  blocked      Boolean        @default(false)
  city         String         @default("")
  clientType   Int            @default(0)
  complement   String         @default("")
  contact      String         @default("")
  createdAt    DateTime?
  creditLimit  String         @default("0")
  fantasyName  String         @default("")
  gender       Int            @default(0)
  lastSaleAt   DateTime?
  neighborhood String         @default("")
  nfeEmail     String         @default("")
  notes        String         @default("")
  number       String         @default("")
  phone2       String         @default("")
  rg           String         @default("")
  sellerCode   Int            @default(0)
  state        String         @default("")
  status       Int            @default(1)
  suframa      String         @default("")
  website      String         @default("")
  zipCode      String         @default("")
  blingContactId String?
  devices      Device[]
  orders       OrdemServico[]
  tags         Tag[]

  @@map("clients")
}

model Device {
  id                String         @id @default(uuid())
  clientId          String?
  type              String
  brand             String
  model             String
  serialNumber      String         @default("Sem Série")
  description       String         @default("Sem observações.")
  deletedAt         DateTime?
  legacyId          String?        @unique
  lastMaintenanceAt DateTime?
  warrantyExpiresAt DateTime?
  acquisitionDate   DateTime?
  clientLegacyId    String?
  notes             String         @default("")
  patrimony         String         @default("")
  status            Int            @default(1)
  deviceNotes       DeviceNote[]
  client            Client?        @relation(fields: [clientId], references: [id])
  orders            OrdemServico[]
  tags              Tag[]

  @@map("devices")
}

model ServiceItem {
  id           String    @id @default(uuid())
  legacyId     String?   @unique
  osLegacyId   String?
  description  String    @default("")
  total        String    @default("0")
  startDate    DateTime?
  endDate      DateTime?
  technicianId Int       @default(0)
  type         Int       @default(0)
  serviceId    Int       @default(0)
  quantity     String    @default("1")
  freight      String    @default("0")
  insurance    String    @default("0")
  otherValue   String    @default("0")
  nfNumber     String?
  cost         String    @default("0")

  @@map("service_items")
}

model PartUsage {
  id           String    @id @default(uuid())
  legacyId     String?   @unique
  osLegacyId   String?
  description  String    @default("")
  partLegacyId Int       @default(0)
  value        String    @default("0")
  cost         String    @default("0")
  technicianId Int       @default(0)
  quantity     Int       @default(1)
  date         DateTime?
  batchInfo    String?
  serialInfo   String?

  @@map("part_usages")
}

model Payment {
  id               String    @id @default(uuid())
  legacyId         String?   @unique
  type             String    @default("R")
  clientLegacyId   String?
  providerLegacyId Int       @default(0)
  dueDate          DateTime?
  paidDate         DateTime?
  paid             String    @default("N")
  value            String    @default("0")
  interest         String    @default("0")
  discount         String    @default("0")
  documentDate     DateTime?
  reference        String    @default("")
  installment      String?
  paymentMethod    Int       @default(0)
  cashAmount       String    @default("0")
  checkAmount      String    @default("0")
  cardAmount       String    @default("0")
  boletoAmount     String    @default("0")
  changeAmount     String    @default("0")
  accountPlan      Int       @default(0)
  currentAccount   Int       @default(0)
  notes            String    @default("")
  collectionNotes  String    @default("")
  cfop             String    @default("0")

  @@map("payments")
}

model Part {
  id                  String    @id @default(uuid())
  name                String
  code                String    @unique
  stock               Int       @default(0)
  cost                Float     @default(0.0)
  price               Float     @default(0.0)
  barcode             String?
  createdAt           DateTime  @default(now())
  deletedAt           DateTime?
  location            String?
  notaFiscalEntradaId String?
  requiresSerial      Boolean   @default(false)
  sku                 String?
  stockMin            Int       @default(0)
  supplier            String?
  supplierId          String?
  supplierRel         Supplier? @relation(fields: [supplierId], references: [id])
  reserved            Int       @default(0)

  // --- Identificação e Classificação ---
  unit                String    @default("UN")
  gtin                String?
  ncm                 String?
  cest                String?
  manufacturerCode    String?
  manufacturer        String?
  cnpjFab             String?
  partGroup           String?
  partSubgroup        String?
  weightGross         Float     @default(0.0)
  weightNet           Float     @default(0.0)

  // --- Tributação ICMS ---
  cstOrigem           String    @default("0")
  cstIcms             String    @default("000")
  icmsAliq            Float     @default(0.0)
  icmsStAliq          Float     @default(0.0)
  icmsRedBc           Float     @default(100.0)

  // --- CFOP ---
  cfopIntraEstadual   String    @default("5102")
  cfopInterEstadual   String    @default("6102")

  // --- IPI ---
  ipiAliq             Float     @default(0.0)
  ipiEnquadramento    String    @default("999")

  // --- PIS / COFINS ---
  pisAliq             Float     @default(0.0)
  cofinsAliq          Float     @default(0.0)

  // --- Outros Fiscais ---
  totalTributos       Float     @default(0.0)
  cBenef              String?
  indEscala           String    @default("S")

  // --- ICMS-ST Retido ---
  bcStRetido          Float     @default(0.0)
  icmsStRetido        Float     @default(0.0)
  aliqSt              Float     @default(0.0)
  icmsSubstituto      Float     @default(0.0)
  redBcEfet           Float     @default(0.0)
  bcEfet              Float     @default(0.0)
  icmsEfetAliq        Float     @default(0.0)
  icmsEfetValor       Float     @default(0.0)

  @@map("parts")
}


model OrdemServico {
  id                   String               @id @default(uuid())
  osNumber             String               @unique
  clientId             String?
  deviceId             String?
  reportedDefect       String               @default("")
  accessoriesLeft      String               @default("Nenhum")
  physicalState        String               @default("Não especificado")
  status               OSStatus             @default(AGUARDANDO_AVALIACAO)
  diagnostic           String?
  usedParts            Json                 @default("[]")
  laborCost            Float                @default(0.0)
  discount             Float                @default(0.0)
  totalCost            Float                @default(0.0)
  billingStatus        String               @default("PENDENTE")
  blingId              String?
  blingKey             String?
  sefazErrorMessage    String?
  pdfUrl               String?
  billingLogs          Json                 @default("[]")
  createdAt            DateTime             @default(now())
  deletedAt            DateTime?
  originalEntryDate    DateTime?
  originalExitDate     DateTime?
  checklistEntrada     Json?                @default("[]")
  laudoFotos           Json?                @default("[]")
  technicianHourlyRate Float?
  technicianLaborHours Float?
  stressTestStartedAt  DateTime?
  checklistSaida       Json?                @default("[]")
  stressTestStartedBy  String?
  recurrent            Boolean              @default(false)
  laudoMacro           String?
  closingReason        OSClosingReason?
  profitValue          Float?
  profitMarginPercent  Float?
  abandonAlert         DateTime?
  advancePayment       Float?
  attendantId          Int                  @default(0)
  budgetForms          String?
  clientLegacyId       String?
  deviceBrand          String               @default("")
  deviceDescription    String               @default("")
  deviceLegacyId       String?
  deviceModel          String               @default("")
  deviceNotes          String               @default("")
  devicePatrimony      String               @default("")
  deviceSerial         String               @default("")
  entryDate            DateTime?
  estimatedDate        DateTime?
  exitDate             DateTime?
  inUse                Boolean              @default(false)
  isReopened           Boolean              @default(false)
  kilometrage          Int                  @default(0)
  microUser            String               @default("")
  nfEmit               Int                  @default(0)
  nfRemessa            Int                  @default(0)
  nfValue              String               @default("0")
  nfcNumber            String?
  nfeNumber            String?
  nfsNumber            String?
  otherCost            Float                @default(0.0)
  partsCost            Float                @default(0.0)
  priority             Int                  @default(1)
  readyDate            DateTime?
  serviceNotes         String               @default("")
  statusCode           Int                  @default(0)
  technicianId         Int                  @default(0)
  thirdPartyCost       Float                @default(0.0)
  travelCost           Float                @default(0.0)
  warrantor            Int                  @default(0)
  warrantorName        String               @default("")
  warrantyDate         DateTime?
  warrantyType         WarrantyType         @default(NENHUMA)
  financialStatus      OSFinancialStatus    @default(PENDENTE)
  paymentMethod        String?
  paymentNotes         String?
  paymentDate          DateTime?
  paymentDetails       Json?                @default("[]")
  financialDueDate     DateTime?
  webKey               String?
  webPassword          String?
  
  // --- Novos Campos de Handoff e Logística (Fase 2) ---
  clientDecision       String?
  approvedBudgetAmount Float?
  returnMethod         String?
  packagingCleaned     Boolean              @default(false)
  benchLocation        String?
  messageHistories     MessageHistory[]
  client               Client?              @relation(fields: [clientId], references: [id])
  device               Device?              @relation(fields: [deviceId], references: [id])
  conciliationItems    OSConciliationItem[]
  tags                 Tag[]

  @@map("ordem_servicos")
  @@index([deletedAt, status, createdAt(sort: Desc)])
  @@index([deletedAt, status, financialStatus])
  @@index([deviceId, deletedAt, createdAt])
  @@index([clientId, deletedAt])
}

model BlingConfig {
  id           Int      @id @default(1)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt

  @@map("bling_configs")
}

model Tag {
  id          String    @id @default(uuid())
  name        String
  colorHex    String    @default("#94a3b8")
  scope       TagScope  @default(GLOBAL)
  description String    @default("")
  ownerId     String?
  createdAt   DateTime  @default(now())

  owner       User?     @relation(fields: [ownerId], references: [id])
  clients     Client[]
  devices     Device[]
  orders      OrdemServico[]

  @@map("tags")
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

model MessageHistory {
  id          String       @id @default(uuid())
  orderId     String       @map("order_id")
  phoneNumber String       @map("phone_number")
  messageText String       @map("message_text")
  status      String
  errorDetail String?      @map("error_detail")
  createdAt   DateTime     @default(now()) @map("created_at")
  order       OrdemServico @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("message_history")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityName String
  entityId   String
  action     String
  oldValue   Json?
  newValue   Json?
  userId     String
  createdAt  DateTime @default(now())
  ipAddress  String?
  reason     String?
  source     String?

  @@map("audit_logs")
}

model DeviceNote {
  id        String   @id @default(uuid())
  deviceId  String
  content   String
  createdBy String
  createdAt DateTime @default(now())
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_notes")
}

model DeviceCategory {
  id               String @id @default(uuid())
  name             String @unique
  defaultChecklist Json   @default("[]")

  @@map("device_categories")
}

model OfficeSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  type        String   @default("string")
  description String?
  updatedAt   DateTime @updatedAt
  category    String   @default("GERAL")

  @@map("office_settings")
}

model RolePermission {
  id         String   @id @default(uuid())
  role       UserRole
  permission String
  createdAt  DateTime @default(now())

  @@unique([role, permission])
  @@map("role_permissions")
}

model OSConciliationBatch {
  id        String               @id @default(uuid())
  createdAt DateTime             @default(now())
  createdBy String
  items     OSConciliationItem[]

  @@map("os_conciliation_batches")
}

model OSConciliationItem {
  id              String              @id @default(uuid())
  batchId         String
  orderId         String
  oldStatus       OSStatus
  newStatus       OSStatus
  reason          String
  undoneAt        DateTime?
  confidence      Int                 @default(0)
  confidenceLevel String              @default("LOW")
  metadata        Json?
  rulesSatisfied  String[]
  sourceFiles     String[]
  batch           OSConciliationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  order           OrdemServico        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("os_conciliation_items")
}

model MigrationRun {
  id                String             @id @default(uuid())
  status            String             @default("PENDING")
  startedAt         DateTime           @default(now())
  finishedAt        DateTime?
  mdbHash           String
  mdbSizeBytes      Int
  extractVersion    String
  dictionaryVersion String
  importerVersion   String
  totalRecords      Int                @default(0)
  createdRecords    Int                @default(0)
  updatedRecords    Int                @default(0)
  skippedRecords    Int                @default(0)
  errorCount        Int                @default(0)
  warningCount      Int                @default(0)
  metadata          Json?
  logs              MigrationLog[]
  mappings          MigrationMapping[]

  @@map("migration_runs")
}

model MigrationLog {
  id               String       @id @default(uuid())
  migrationRunId   String
  phase            String
  status           String
  startedAt        DateTime     @default(now())
  finishedAt       DateTime?
  recordsProcessed Int          @default(0)
  errors           Json?
  warnings         Json?
  migrationRun     MigrationRun @relation(fields: [migrationRunId], references: [id])

  @@map("migration_logs")
}

model MigrationMapping {
  id             String       @id @default(uuid())
  migrationRunId String
  sourceTable    String
  sourceId       String
  version        Int          @default(1)
  row            Json
  targetTable    String?
  targetId       String?
  createdAt      DateTime     @default(now())
  migrationRun   MigrationRun @relation(fields: [migrationRunId], references: [id])

  @@unique([migrationRunId, sourceTable, sourceId])
  @@map("migration_mappings")
}

enum UserRole {
  OWNER
  EDITOR
  ATTENDANT
  TECHNICIAN
  FINANCIAL
  ADMIN
  SUPERVISOR
}

enum TagScope {
  GLOBAL
  CLIENT
  DEVICE
  ORDEM_SERVICO
}

enum OSStatus {
  ORCAMENTO
  AGUARDANDO_PECA
  EM_MANUTENCAO
  PRONTO_RETIRADA
  FINALIZADO
  PAGO_PRONTO_RETIRADA
  AGUARDANDO_AVALIACAO
  AGUARDANDO_AUTORIZACAO
}

enum OSClosingReason {
  REPARO_CONCLUIDO
  ORCAMENTO_RECUSADO
  DESCARTE_CLIENTE_RETIRA
  DESCARTE_OFICINA
}

enum WarrantyType {
  NENHUMA
  FABRICA
  MGV
}

enum OSFinancialStatus {
  PENDENTE
  CREDIARIO
  PAGAR_DEPOIS
  PAGO
  INADIMPLENTE
}

model Supplier {
  id             String    @id @default(uuid())
  name           String    @map("razao_social")
  fantasyName    String?   @map("fantasia")
  cpfCnpj        String?   @map("cnpj_cpf")
  ie             String?   @map("ie_rg")
  im             String?   @map("inscricao_municipal")
  address        String?   @map("endereco")
  neighborhood   String?   @map("bairro")
  city           String?   @map("cidade")
  state          String?   @map("uf")
  zipCode        String?   @map("cep")
  phone          String?   @map("telefone")
  fax            String?   @map("fax")
  email          String?   @map("email")
  website        String?   @map("site")
  contactName    String?   @map("contato")
  isCarrier      Boolean   @default(false) @map("transportadora")
  notes          String?   @map("observacao")
  legacyId       String?   @unique @map("legacy_id")
  createdAt      DateTime  @default(now()) @map("cadastrado_em")
  deletedAt      DateTime? @map("deleted_at")
  lastPurchaseAt DateTime? @map("ultima_compra_em")

  parts          Part[]

  @@map("fornecedores")
}

model CustomField {
  id          String             @id @default(uuid())
  entityType  String             // "CLIENT", "DEVICE", "ORDEM_SERVICO"
  label       String
  type        String             // "TEXT", "NUMBER", "CHECKBOX", "SELECT"
  options     String[]           @default([]) // Opções para tipo SELECT
  required    Boolean            @default(false)
  order       Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  values      CustomFieldValue[]

  @@map("custom_fields")
}

model CustomFieldValue {
  id            String      @id @default(uuid())
  customFieldId String
  entityId      String      // ID do Client, Device ou OrdemServico
  value         String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  customField   CustomField @relation(fields: [customFieldId], references: [id])

  @@unique([customFieldId, entityId])
  @@map("custom_field_values")
}
