datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  EDITOR
}

enum OSStatus {
  ORCAMENTO
  AGUARDANDO_PECA
  EM_MANUTENCAO
  PRONTO_RETIRADA
  FINALIZADO
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(EDITOR)
  createdAt    DateTime @default(now())

  @@map("users")
}

model Client {
  id        String         @id @default(uuid())
  name      String
  cpfCnpj   String
  phone     String
  email     String
  address   String
  deletedAt DateTime?
  devices   Device[]
  orders    OrdemServico[]

  @@map("clients")
}

model Device {
  id           String         @id @default(uuid())
  clientId     String
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type         String
  brand        String
  model        String
  serialNumber String         @default("Sem Série")
  description  String         @default("Sem observações.")
  deletedAt    DateTime?
  orders       OrdemServico[]

  @@map("devices")
}

model Part {
  id    String @id @default(uuid())
  name  String
  code  String @unique
  stock Int    @default(0)
  cost  Float  @default(0.0)
  price Float  @default(0.0)

  @@map("parts")
}

model OrdemServico {
  id                String    @id @default(uuid())
  osNumber          String    @unique
  clientId          String
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deviceId          String
  device            Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  reportedDefect    String
  accessoriesLeft   String    @default("Nenhum")
  physicalState     String    @default("Não especificado")
  status            OSStatus  @default(ORCAMENTO)
  diagnostic        String?
  usedParts         Json      @default("[]") // Stores array of UsedPart { partId, name, quantity, price }
  laborCost         Float     @default(0.0)
  totalCost         Float     @default(0.0)
  billingStatus     String    @default("PENDENTE") // PENDENTE, PROCESSANDO, FATURADO, REJEITADO, TIMEOUT
  blingId           String?
  blingKey          String?
  sefazErrorMessage String?
  pdfUrl            String?
  billingLogs       Json      @default("[]") // Stores string array of logs
  createdAt         DateTime  @default(now())
  deletedAt         DateTime?

  @@map("ordem_servicos")
}

model BlingConfig {
  id           Int      @id @default(1)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt

  @@map("bling_configs")
}

