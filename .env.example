# ─── OS FLOW SAAS — Configurações de Ambiente (Produção/VPS) ───

# Ambiente de Execução
NODE_ENV=production
PORT=3000

# Conexão com o Banco de Dados PostgreSQL Multitenant
DATABASE_URL="postgresql://usuario:senha@localhost:5432/osflow_db?schema=public&sslmode=disable"
DIRECT_URL="postgresql://usuario:senha@localhost:5432/osflow_db?schema=public&sslmode=disable"

# Chave Secreta para Sessões JWT (Gere uma chave segura e aleatória)
JWT_SECRET="sua_chave_secreta_jwt_longa_e_segura_aqui"

# Armazenamento Local de Arquivos
STORAGE_TYPE=disk
